root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,xaml,json,yml,yaml}]
indent_size = 2

[*.{md,yml,yaml,sh}]
end_of_line = lf

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
csharp_style_var_for_built_in_types = true:suggestion
# Chuỗi giao diện tiếng Việt viết trực tiếp trong MVP (Q-09); bỏ cảnh báo localization.
dotnet_diagnostic.CA1303.severity = none
# Ứng dụng desktop: không cần ConfigureAwait trong ViewModel.
dotnet_diagnostic.CA2007.severity = none
