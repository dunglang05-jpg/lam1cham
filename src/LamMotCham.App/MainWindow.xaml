<Window x:Class="LamMotCham.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
        xmlns:views="clr-namespace:LamMotCham.App.Views"
        xmlns:c="clr-namespace:LamMotCham.App.Controls"
        xmlns:pages="clr-namespace:LamMotCham.App.Views.Pages"
        xmlns:dialogs="clr-namespace:LamMotCham.App.Views.Dialogs"
        Title="Làm 1 Chạm"
        Icon="pack://application:,,,/Assets/app.ico"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!-- Mô-đun "shell" (QĐ-002): khung ứng dụng. Nội dung mỗi trang là một mô-đun riêng trong Views/Pages. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><pages:OverviewPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SoftwareViewModel}"><pages:SoftwarePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsViewModel}"><pages:WindowsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskViewModel}"><pages:DiskPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><pages:CleanupPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HandoverViewModel}"><pages:HandoverPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModulesViewModel}"><pages:ModulesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}"><dialogs:ConfirmDialog /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ErrorDialogViewModel}"><dialogs:ErrorDialog /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestartDialogViewModel}"><dialogs:RestartDialog /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ListDialogViewModel}"><dialogs:ListDialog /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserEditDialogViewModel}"><dialogs:UserEditDialog /></DataTemplate>
    </Window.Resources>

    <!-- Root được co giãn (LayoutTransform) theo kích thước cửa sổ để thông tin vừa một màn hình. -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- THANH BÊN (navy) -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="13,21,13,14">
                <!-- Thương hiệu -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="39" Height="39" Style="{StaticResource IconImage}" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <TextBlock Text="Làm 1 Chạm" FontSize="17" FontWeight="ExtraBold" Foreground="White" />
                        <TextBlock Text="Một chạm – Sẵn sàng sử dụng" FontSize="11" Foreground="#ADC8EF" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Hệ thống: log, báo cáo, trợ giúp, phiên bản -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="HỆ THỐNG" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource NavLabelBrush}" Margin="12,12,0,6"
                               Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <Button Style="{StaticResource SideButton}" Command="{Binding OpenLogsCommand}" ToolTip="Mở thư mục log" AutomationProperties.Name="Mở log">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=history}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,11,0" />
                            <TextBlock Text="Nhật ký (log)" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideButton}" Command="{Binding OpenReportsCommand}" ToolTip="Mở thư mục báo cáo" AutomationProperties.Name="Mở báo cáo">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=report}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,11,0" />
                            <TextBlock Text="Báo cáo" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Button>
                    <Border Margin="5,12,5,10" Padding="13" CornerRadius="12" Background="#0CFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1"
                            Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="Cần hỗ trợ?" FontSize="12" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Quy trình, trạng thái và nguyên tắc an toàn." FontSize="11" Foreground="#9FB7DA" TextWrapping="Wrap" Margin="0,4,0,9" />
                            <Button Command="{Binding HelpCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="Mở trợ giúp">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#13FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="7" Padding="9,7">
                                            <TextBlock Text="Mở trợ giúp" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- Mô-đun "account": người đang đăng nhập + đăng xuất (phiên chỉ trong lần chạy này) -->
                    <DockPanel Margin="12,2,6,4" ToolTip="{Binding AccountRoleText}"
                               Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <TextBlock Text="{Binding AccountInitial}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountName}" FontSize="12" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AccountRoleText}" FontSize="10" Foreground="#9FB7DA" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Button Style="{StaticResource SideButton}" Command="{Binding SignOutCommand}" ToolTip="Đăng xuất" AutomationProperties.Name="Đăng xuất" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=user}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,11,0" />
                            <TextBlock Text="Đăng xuất" VerticalAlignment="Center"
                                       Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="{StaticResource NavLabelBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Mô-đun -->
                <StackPanel>
                    <TextBlock Text="KHÔNG GIAN LÀM VIỆC" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource NavLabelBrush}" Margin="12,0,0,6"
                               Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Nav}" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Mô-đun">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,11,0" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- KHÔNG GIAN LÀM VIỆC -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopBarRow" Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Thanh trên: đường dẫn trang, tìm tính năng, quyền -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="25,0">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text2Brush}">
                        <Run Text="Không gian làm việc" /><Run Text="   /   " /><Run Text="{Binding CurrentPageTitle, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tìm tính năng: gõ, rồi bấm kết quả hoặc Enter để mở trang -->
                        <Grid Width="250">
                            <Border x:Name="SearchBox" Background="#F8FAFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Height="36">
                                <Grid>
                                    <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=search}" Width="15" Height="15" Style="{StaticResource IconImage}"
                                           HorizontalAlignment="Left" Margin="11,0,0,0" />
                                    <TextBlock Text="Tìm tính năng..." FontSize="12" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False"
                                               Visibility="{Binding SearchText, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />
                                    <TextBox x:Name="SearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="32,0,8,0" MinHeight="0"
                                             Background="Transparent" VerticalContentAlignment="Center" AutomationProperties.Name="Tìm tính năng">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                                            </ControlTemplate>
                                        </TextBox.Template>
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding OpenSearchHitCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </Border>
                            <Popup PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="True"
                                   IsOpen="{Binding SearchOpen, Mode=OneWay}">
                                <Border Width="320" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,12,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.16" Color="#18345C" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding SearchHits}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SearchHit}">
                                                    <Button Command="{Binding DataContext.OpenSearchHitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,7">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource Text2Brush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Không tìm thấy tính năng phù hợp." FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="10,7"
                                                   Visibility="{Binding SearchNoHits, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Quyền -->
                        <Border Style="{StaticResource TagGreen}" Margin="12,0,0,0" Padding="10,6" Visibility="{Binding IsElevated, Converter={StaticResource Vis}}">
                            <TextBlock Text="● Quyền quản trị" Style="{StaticResource TagGreenText}" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" MinHeight="36" FontSize="12" Padding="12,0" Margin="12,0,0,0" Content="Nâng quyền quản trị…"
                                Command="{Binding ElevateCommand}" ToolTip="Mở lại ứng dụng với quyền quản trị (Windows sẽ hỏi UAC)"
                                Visibility="{Binding IsElevated, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Nội dung mô-đun -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl x:Name="PageHost" Content="{Binding CurrentPageViewModel}" Margin="20" Focusable="False" />
            </ScrollViewer>

            <!-- Chân trang -->
            <Border x:Name="Footer" Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#E6EDF6" BorderThickness="0,1,0,0" Padding="25,9">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Chạy trực tiếp – Không cần cài đặt" FontSize="11" Foreground="#8491A4" />
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="#8491A4">
                        <Run Text="© 2026 Làm 1 Chạm" /><Run Text="  ·  " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ĐANG THỰC HIỆN / KẾT QUẢ -->
        <views:RunOverlay Grid.ColumnSpan="2" Visibility="{Binding DockVisible, Converter={StaticResource Vis}}" />

        <!-- HỘP THOẠI (nằm trên cùng, kể cả khi đang chạy) -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}" Visibility="{Binding HasDialog, Converter={StaticResource Vis}}">
            <Border MaxWidth="600" Margin="24" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.25" Color="#101828" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding Dialog}" Focusable="False" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MÀN HÌNH KHỞI ĐỘNG: các bước nạp thật (cấu hình, pin, mạng, WinGet) -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource BackgroundBrush}" Visibility="{Binding Machine.IsStarting, Converter={StaticResource Vis}}">
            <Border MaxWidth="520" Margin="24" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Đang khởi động">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.14" Color="#10213F" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="52" Height="52" Style="{StaticResource IconImage}" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Làm 1 Chạm" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                                <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="6" Background="{StaticResource PrimaryTintBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Một chạm – Sẵn sàng sử dụng" FontSize="13" Foreground="{StaticResource Text2Brush}" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Machine.StartupPercent, Mode=OneWay}" Maximum="100" Margin="0,24,0,0"
                                 AutomationProperties.Name="Tiến độ khởi động" />
                    <TextBlock Text="{Binding Machine.StartupText}" FontSize="13" Foreground="{StaticResource Text3Brush}" Margin="0,8,0,10" />
                    <ItemsControl ItemsSource="{Binding Machine.StartupSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StartupStep}">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}" />
                                    </StackPanel>
                                    <c:StatusChip Grid.Column="1" State="{Binding StateKey}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
