<Window x:Class="LamMotCham.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
        xmlns:views="clr-namespace:LamMotCham.App.Views"
        xmlns:c="clr-namespace:LamMotCham.App.Controls"
        xmlns:pages="clr-namespace:LamMotCham.App.Views.Pages"
        xmlns:dialogs="clr-namespace:LamMotCham.App.Views.Dialogs"
        Title="Làm 1 Chạm"
        Icon="pack://application:,,,/Assets/app.ico"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!-- Mô-đun "shell" (QĐ-002): khung ứng dụng. Nội dung mỗi trang là một mô-đun riêng trong Views/Pages. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><pages:OverviewPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SoftwareViewModel}"><pages:SoftwarePage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsViewModel}"><pages:WindowsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskViewModel}"><pages:DiskPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><pages:CleanupPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HandoverViewModel}"><pages:HandoverPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModulesViewModel}"><pages:ModulesPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}"><dialogs:ConfirmDialog /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ErrorDialogViewModel}"><dialogs:ErrorDialog /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestartDialogViewModel}"><dialogs:RestartDialog /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ListDialogViewModel}"><dialogs:ListDialog /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- THANH TIÊU ĐỀ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0,16,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="38" Height="38" Style="{StaticResource IconImage}" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Làm 1 Chạm" FontSize="18" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                            <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="6" Background="{StaticResource PrimaryTintBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Một chạm – Sẵn sàng sử dụng" FontSize="11" Foreground="{StaticResource Text2Brush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Height="28" Padding="10,0,12,0" CornerRadius="14" Background="{StaticResource SuccessTintBrush}" Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=check}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,6,0" />
                            <TextBlock Text="Chạy trực tiếp – Không cần cài đặt" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Margin="10,0,0,0" Height="28" Padding="10,0,12,0" CornerRadius="14" Background="{StaticResource PrimaryTintBrush}"
                            Visibility="{Binding IsElevated, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=shield}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,6,0" />
                            <TextBlock Text="Quyền quản trị" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" MinHeight="32" FontSize="12" Padding="10,0" Margin="10,0,0,0" Content="Nâng quyền quản trị…"
                            Command="{Binding ElevateCommand}" ToolTip="Mở lại ứng dụng với quyền quản trị (Windows sẽ hỏi UAC)"
                            Visibility="{Binding IsElevated, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <Border Width="1" Height="22" Margin="12,0,6,0" Background="{StaticResource LineBrush}" />
                    <Button Style="{StaticResource QuietButton}" Command="{Binding HelpCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=info}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,6,0" />
                            <TextBlock Text="Trợ giúp" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- THANH BÊN -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18">
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Command="{Binding GoModulesCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" ToolTip="Mô-đun &amp; Cập nhật"
                                AutomationProperties.Name="Mô-đun và cập nhật">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{Binding ModulesSelected, Converter={StaticResource ActiveSoftBg}}"
                                            BorderBrush="{Binding ModulesSelected, Converter={StaticResource ActiveBorder}}"
                                            BorderThickness="1.5" CornerRadius="12" Padding="14,12">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=refresh}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                                    <TextBlock Text="Mô-đun &amp; Cập nhật" FontSize="13" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" VerticalAlignment="Center" Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                </StackPanel>
                                <Grid Margin="0,8,0,0" Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Phiên bản" FontSize="12" Foreground="{StaticResource Text2Brush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="12" Foreground="{StaticResource Text3Brush}" />
                                    <TextBlock Grid.Row="1" Text="Mô-đun" FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModuleCountText}" FontSize="12" Foreground="{StaticResource Text3Brush}" Margin="0,3,0,0" />
                                </Grid>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="4,10,0,0" Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}">
                            <Button Style="{StaticResource TertiaryButton}" FontSize="12" MinHeight="30" Content="Mở log" Command="{Binding OpenLogsCommand}" />
                            <Button Style="{StaticResource TertiaryButton}" FontSize="12" MinHeight="30" Content="Mở báo cáo" Command="{Binding OpenReportsCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Nav}" KeyboardNavigation.TabNavigation="Once">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,12,0"
                                                Background="{Binding IsSelected, Converter={StaticResource NavTileBg}}">
                                            <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- KHU VỰC MÔ-ĐUN -->
            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl x:Name="PageHost" Content="{Binding CurrentPageViewModel}" Margin="28,24" Focusable="False" />
            </ScrollViewer>
        </Grid>

        <!-- ĐANG THỰC HIỆN / KẾT QUẢ -->
        <views:RunOverlay Grid.RowSpan="2" Visibility="{Binding DockVisible, Converter={StaticResource Vis}}" />

        <!-- HỘP THOẠI (nằm trên cùng, kể cả khi đang chạy) -->
        <Grid Grid.RowSpan="2" Background="{StaticResource OverlayBrush}" Visibility="{Binding HasDialog, Converter={StaticResource Vis}}">
            <Border MaxWidth="600" Margin="24" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.25" Color="#101828" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding Dialog}" Focusable="False" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MÀN HÌNH KHỞI ĐỘNG: các bước nạp thật (cấu hình, pin, mạng, WinGet) -->
        <Grid Grid.RowSpan="2" Background="{StaticResource BackgroundBrush}" Visibility="{Binding Machine.IsStarting, Converter={StaticResource Vis}}">
            <Border MaxWidth="520" Margin="24" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="32,28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Đang khởi động">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.14" Color="#10213F" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="52" Height="52" Style="{StaticResource IconImage}" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Làm 1 Chạm" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                                <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="6" Background="{StaticResource PrimaryTintBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Một chạm – Sẵn sàng sử dụng" FontSize="13" Foreground="{StaticResource Text2Brush}" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Machine.StartupPercent, Mode=OneWay}" Maximum="100" Margin="0,24,0,0"
                                 AutomationProperties.Name="Tiến độ khởi động" />
                    <TextBlock Text="{Binding Machine.StartupText}" FontSize="13" Foreground="{StaticResource Text3Brush}" Margin="0,8,0,10" />
                    <ItemsControl ItemsSource="{Binding Machine.StartupSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StartupStep}">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Detail, Converter={StaticResource NotEmpty}}" />
                                    </StackPanel>
                                    <c:StatusChip Grid.Column="1" State="{Binding StateKey}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
