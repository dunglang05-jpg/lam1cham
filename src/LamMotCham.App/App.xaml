<Application x:Class="LamMotCham.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LamMotCham.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:IconConverter x:Key="Icon" />
            <conv:LogoOrIconConverter x:Key="LogoOrIcon" />
            <conv:BoolToVisibilityConverter x:Key="Vis" />
            <conv:EmptyToCollapsedConverter x:Key="NotEmpty" />
            <conv:BoolToTextConverter x:Key="ReadOnlyVerb" TrueText="Kiểm tra" FalseText="Áp dụng" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
