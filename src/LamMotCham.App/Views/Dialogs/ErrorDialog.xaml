<UserControl x:Class="LamMotCham.App.Views.Dialogs.ErrorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <StackPanel>
        <DockPanel Margin="0,0,0,14">
            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=xcircle}" Width="32" Height="32" Style="{StaticResource IconImage}" Margin="0,0,12,0" />
            <c:StatusChip DockPanel.Dock="Right" State="{Binding StateKey}" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock Text="ĐIỀU GÌ ĐÃ XẢY RA" Style="{StaticResource ColumnHeader}" />
        <TextBlock Text="{Binding What}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,12" />

        <TextBlock Text="ẢNH HƯỞNG" Style="{StaticResource ColumnHeader}" />
        <TextBlock Text="{Binding Impact}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,12" />

        <TextBlock Text="NÊN LÀM GÌ TIẾP" Style="{StaticResource ColumnHeader}" />
        <TextBlock Text="{Binding Next}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,12" />

        <Expander Header="Chi tiết kỹ thuật" Margin="0,0,0,12" Visibility="{Binding Technical, Converter={StaticResource NotEmpty}}">
            <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Background="{StaticResource SubtleBrush}" Height="Auto" MaxHeight="160" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,8,0,0"
                     VerticalContentAlignment="Top" />
        </Expander>

        <Grid Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TertiaryButton}" Content="Sao chép chi tiết" Command="{Binding CopyCommand}" Margin="0,0,6,0"
                        Visibility="{Binding Technical, Converter={StaticResource NotEmpty}}" />
                <Button Style="{StaticResource TertiaryButton}" Content="Mở thư mục log" Command="{Binding OpenLogCommand}" />
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="Đóng" Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" />
        </Grid>
    </StackPanel>
</UserControl>
