<UserControl x:Class="LamMotCham.App.Views.Dialogs.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <StackPanel>
        <DockPanel Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryTintBrush}" Margin="0,0,12,0">
                <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="24" Height="24" Style="{StaticResource IconImage}" />
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="{Binding Lead}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding Lead, Converter={StaticResource NotEmpty}}" />

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12"
                Visibility="{Binding Items, Converter={StaticResource NotEmpty}}">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DialogItem}">
                            <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Visibility="{Binding Subtitle, Converter={StaticResource NotEmpty}}" />
                                    </StackPanel>
                                    <c:StatusChip Grid.Column="1" State="{Binding StateKey}" Text="{Binding StateText}" Margin="8,0,0,0"
                                                  Visibility="{Binding StateKey, Converter={StaticResource NotEmpty}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Trailing}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Text2Brush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding Trailing, Converter={StaticResource NotEmpty}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ItemsControl ItemsSource="{Binding Facts}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DialogFact}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Text2Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Cảnh báo: đỏ chỉ khi có nguy cơ mất dữ liệu, còn lại màu vàng. -->
        <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderThickness="1"
                Visibility="{Binding Warning, Converter={StaticResource NotEmpty}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WarningIsDanger}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ErrorTintBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ErrorLineBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=alert}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Warning}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WarningIsDanger}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <CheckBox IsChecked="{Binding Agreed}" Margin="0,0,0,12" Visibility="{Binding RequireAgreement, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding AgreementText}" TextWrapping="Wrap" FontSize="13" />
        </CheckBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{Binding SecondaryText}" Command="{Binding CloseCommand}" IsCancel="True" Margin="0,0,10,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
