<UserControl x:Class="LamMotCham.App.Views.Dialogs.UserEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mô-đun "disk": sửa tài khoản cục bộ. Mật khẩu lấy trực tiếp từ PasswordBox, không qua binding. -->
    <StackPanel Width="440">
        <DockPanel Margin="0,0,0,14">
            <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=user}" Width="22" Height="22" Style="{StaticResource IconImage}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sửa tài khoản" Style="{StaticResource H2}" />
                <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}">
                    <Run Text="{Binding Account.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Account.KindText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Tên hiển thị" FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" MinHeight="36" AutomationProperties.Name="Tên hiển thị" />
        <TextBlock Text="Hiện ở màn hình đăng nhập và menu Start." FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,10" />

        <TextBlock Text="Tên đăng nhập" FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" MinHeight="36" AutomationProperties.Name="Tên đăng nhập" />
        <TextBlock Text="Thư mục C:\Users\... giữ nguyên tên cũ." FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,10" />

        <TextBlock Text="Mật khẩu mới (để trống nếu không đổi)" FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="Password" PasswordChanged="OnPasswordChanged" MinHeight="36" Padding="10,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Mật khẩu mới" />
            <PasswordBox x:Name="PasswordConfirm" Grid.Column="2" PasswordChanged="OnPasswordConfirmChanged" MinHeight="36" Padding="10,0" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Nhập lại mật khẩu mới" />
        </Grid>
        <TextBlock Text="Nhập 2 lần giống nhau." FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,10" />

        <!-- Cảnh báo khi đặt mật khẩu mới -->
        <Border Background="{StaticResource WarningTintBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                Visibility="{Binding ChangesPassword, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap"
                           Text="Đặt lại mật khẩu bằng quyền quản trị: mật khẩu đã lưu của tài khoản này (Credential Manager, file mã hóa EFS) có thể không mở được nữa. Không khôi phục được mật khẩu cũ." />
                <CheckBox IsChecked="{Binding Agreed}" Margin="0,8,0,0">
                    <TextBlock Text="Khách hàng đồng ý đặt mật khẩu mới cho tài khoản này." FontSize="12" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
        </Border>
        <TextBlock Text="Đổi tên đăng nhập của tài khoản đang dùng: đăng xuất rồi đăng nhập lại để thấy tên mới." FontSize="11"
                   Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding RenamesCurrentUser, Converter={StaticResource Vis}}" />

        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap"
                   Visibility="{Binding Summary, Converter={StaticResource NotEmpty}}" />
        <TextBlock Text="{Binding Problem}" FontSize="12" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding Problem, Converter={StaticResource NotEmpty}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Hủy" Command="{Binding CloseCommand}" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Lưu thay đổi" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
