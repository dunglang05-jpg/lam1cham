<Window x:Class="LamMotCham.App.Views.Dialogs.ProInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khám phá Làm 1 Chạm Pro"
        Width="660" Height="620" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                CornerRadius="16" Padding="22,20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="14" Background="#FFF3D6" VerticalAlignment="Top">
                    <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=badge}" Width="32" Height="32" Style="{StaticResource IconImage}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Làm 1 Chạm Pro" FontSize="23" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                        <Border Margin="10,3,0,0" Background="{StaticResource WarningTintBrush}" CornerRadius="6" Padding="8,3">
                            <TextBlock Text="ĐANG PHÁT TRIỂN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningTextBrush}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="Thêm sức mạnh cho đội kỹ thuật và cửa hàng cần chuẩn hóa nhiều laptop." FontSize="14"
                               Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Dự kiến có trong Pro" Style="{StaticResource H2}" Margin="2,0,0,10" />
            <UniformGrid Columns="2" Rows="2">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,8,8">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" CornerRadius="11" Margin="0,0,0,10">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=grid}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="Hồ sơ cài đặt" FontSize="14" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="Lưu cấu hình phần mềm và tác vụ theo cửa hàng hoặc nhóm máy." Style="{StaticResource Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="8,0,0,8">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" CornerRadius="11" Margin="0,0,0,10">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=report}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="Báo cáo chuyên sâu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="Tổng hợp thời gian xử lý, lỗi thường gặp và xuất báo cáo nâng cao." Style="{StaticResource Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,8,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" CornerRadius="11" Margin="0,0,0,10">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=laptop}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="Quản lý nhiều laptop" FontSize="14" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="Theo dõi trạng thái thiết bị, phiên bản và kết quả chuẩn bị máy." Style="{StaticResource Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="8,8,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}" Width="40" Height="40" CornerRadius="11" Margin="0,0,0,10">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=bolt}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="Workflow chuẩn hóa" FontSize="14" FontWeight="Bold" Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="Dùng chuỗi tác vụ đã định nghĩa sẵn, có xác nhận và lưu vết." Style="{StaticResource Secondary}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Background="{StaticResource InfoTintBrush}" CornerRadius="12" Padding="14,12" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Bản hiện tại chưa có thanh toán hoặc xác minh giấy phép Pro." FontWeight="SemiBold" Foreground="{StaticResource InfoTextBrush}" />
                    <TextBlock Text="Nút Pro hiện chỉ mở trang giới thiệu. Không có khoản phí nào được tạo và tính năng trả phí chưa được bật." FontSize="12"
                               Foreground="{StaticResource InfoTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left" Text="Làm 1 Chạm · Một chạm — Sẵn sàng sử dụng" Style="{StaticResource Meta}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Đã hiểu" MinWidth="112" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
