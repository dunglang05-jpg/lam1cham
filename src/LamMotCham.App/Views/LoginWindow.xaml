<Window x:Class="LamMotCham.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Làm 1 Chạm · Đăng nhập"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="920" Height="600" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!-- Mô-đun "account" (QĐ-002): đăng nhập / đăng ký trước khi vào ứng dụng.
         Mật khẩu lấy trực tiếp từ PasswordBox (code-behind), không qua binding. Phiên chỉ giữ trong lần chạy này. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>

        <!-- BẢNG THƯƠNG HIỆU (cùng nền với thanh bên) + hiệu ứng vũ trụ nhẹ: sao, sao nhấp nháy, tinh vân, sao băng, hành tinh trôi.
             Chỉ hoạt ảnh độ mờ/vị trí (rẻ, không làm nặng máy); không nhận chuột. -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" ClipToBounds="True">
            <Grid>
                <Viewbox Stretch="UniformToFill" IsHitTestVisible="False" AutomationProperties.Name="Nền vũ trụ">
                    <Canvas Width="400" Height="640">
                        <!-- Tinh vân -->
                        <Ellipse Canvas.Left="170" Canvas.Top="-120" Width="360" Height="300">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#557C4DFF" Offset="0" />
                                    <GradientStop Color="#007C4DFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="-160" Canvas.Top="330" Width="380" Height="320">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#40268CFF" Offset="0" />
                                    <GradientStop Color="#00268CFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="210" Canvas.Top="520" Width="260" Height="200">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#26FF5AC8" Offset="0" />
                                    <GradientStop Color="#00FF5AC8" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Sao tĩnh -->
                            <Ellipse Canvas.Left="181" Canvas.Top="358" Width="1.4" Height="1.4" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="203" Canvas.Top="375" Width="1" Height="1" Fill="White" Opacity="0.9" />
                            <Ellipse Canvas.Left="190" Canvas.Top="392" Width="1" Height="1" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="179" Canvas.Top="94" Width="1.4" Height="1.4" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="237" Canvas.Top="254" Width="1.4" Height="1.4" Fill="White" Opacity="0.9" />
                            <Ellipse Canvas.Left="259" Canvas.Top="398" Width="1.4" Height="1.4" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="27" Canvas.Top="124" Width="1" Height="1" Fill="White" Opacity="0.9" />
                            <Ellipse Canvas.Left="16" Canvas.Top="297" Width="1.4" Height="1.4" Fill="White" Opacity="0.9" />
                            <Ellipse Canvas.Left="334" Canvas.Top="332" Width="2" Height="2" Fill="White" Opacity="0.6" />
                            <Ellipse Canvas.Left="200" Canvas.Top="423" Width="1.4" Height="1.4" Fill="White" Opacity="0.6" />
                            <Ellipse Canvas.Left="163" Canvas.Top="352" Width="1" Height="1" Fill="White" Opacity="0.6" />
                            <Ellipse Canvas.Left="128" Canvas.Top="149" Width="1" Height="1" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="32" Canvas.Top="488" Width="1.4" Height="1.4" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="336" Canvas.Top="248" Width="1" Height="1" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="88" Canvas.Top="590" Width="1" Height="1" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="151" Canvas.Top="452" Width="1.4" Height="1.4" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="226" Canvas.Top="129" Width="2" Height="2" Fill="White" Opacity="0.6" />
                            <Ellipse Canvas.Left="136" Canvas.Top="201" Width="1" Height="1" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="301" Canvas.Top="79" Width="1" Height="1" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="8" Canvas.Top="298" Width="1.4" Height="1.4" Fill="White" Opacity="0.5" />
                            <Ellipse Canvas.Left="271" Canvas.Top="123" Width="1.4" Height="1.4" Fill="White" Opacity="0.5" />
                            <Ellipse Canvas.Left="390" Canvas.Top="490" Width="1.4" Height="1.4" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="50" Canvas.Top="270" Width="1" Height="1" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="110" Canvas.Top="618" Width="1.4" Height="1.4" Fill="White" Opacity="0.6" />
                            <Ellipse Canvas.Left="395" Canvas.Top="16" Width="1" Height="1" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="394" Canvas.Top="384" Width="1.4" Height="1.4" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="21" Canvas.Top="96" Width="1.4" Height="1.4" Fill="White" Opacity="0.6" />
                            <Ellipse Canvas.Left="8" Canvas.Top="390" Width="1" Height="1" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="33" Canvas.Top="61" Width="1.4" Height="1.4" Fill="White" Opacity="0.5" />
                            <Ellipse Canvas.Left="10" Canvas.Top="237" Width="1.4" Height="1.4" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="54" Canvas.Top="375" Width="1.4" Height="1.4" Fill="White" Opacity="0.5" />
                            <Ellipse Canvas.Left="344" Canvas.Top="120" Width="1" Height="1" Fill="White" Opacity="0.6" />
                            <Ellipse Canvas.Left="360" Canvas.Top="521" Width="1" Height="1" Fill="White" Opacity="0.5" />
                            <Ellipse Canvas.Left="66" Canvas.Top="402" Width="1.4" Height="1.4" Fill="White" Opacity="0.5" />
                            <Ellipse Canvas.Left="273" Canvas.Top="249" Width="1.4" Height="1.4" Fill="White" Opacity="0.9" />
                            <Ellipse Canvas.Left="35" Canvas.Top="34" Width="1" Height="1" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="205" Canvas.Top="165" Width="2" Height="2" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="105" Canvas.Top="525" Width="1.4" Height="1.4" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="119" Canvas.Top="115" Width="2" Height="2" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="54" Canvas.Top="307" Width="2" Height="2" Fill="White" Opacity="0.9" />
                            <Ellipse Canvas.Left="245" Canvas.Top="181" Width="1" Height="1" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="31" Canvas.Top="264" Width="1" Height="1" Fill="White" Opacity="0.35" />
                            <Ellipse Canvas.Left="22" Canvas.Top="182" Width="1.4" Height="1.4" Fill="White" Opacity="0.9" />
                            <Ellipse Canvas.Left="385" Canvas.Top="62" Width="1" Height="1" Fill="White" Opacity="0.75" />
                            <Ellipse Canvas.Left="388" Canvas.Top="419" Width="2" Height="2" Fill="White" Opacity="0.9" />
                            <Ellipse Canvas.Left="233" Canvas.Top="93" Width="1" Height="1" Fill="White" Opacity="0.35" />
                        <!-- Sao nhấp nháy -->
                            <Ellipse Canvas.Left="190" Canvas.Top="232" Width="3" Height="3" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:0.1">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Canvas.Left="252" Canvas.Top="309" Width="2" Height="2" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:0.8">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Canvas.Left="39" Canvas.Top="349" Width="3" Height="3" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:2.3">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Canvas.Left="290" Canvas.Top="90" Width="2" Height="2" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:0.9">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:3.1" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Canvas.Left="270" Canvas.Top="569" Width="2" Height="2" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:1.0">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:3.0" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Canvas.Left="338" Canvas.Top="365" Width="3" Height="3" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:1.0">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Canvas.Left="15" Canvas.Top="55" Width="2.4" Height="2.4" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:0.3">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Canvas.Left="344" Canvas.Top="461" Width="3" Height="3" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:1.8">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Canvas.Left="184" Canvas.Top="297" Width="3" Height="3" Fill="#DDE9FF">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard BeginTime="0:0:1.3">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        <!-- Sao băng: lướt chéo mỗi 7 giây -->
                        <Rectangle Width="70" Height="1.5" Opacity="0" RadiusX="1" RadiusY="1">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#FFFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="28" />
                                    <TranslateTransform x:Name="MeteorMove" X="60" Y="40" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" Duration="0:0:7">
                                            <DoubleAnimation Storyboard.TargetName="MeteorMove" Storyboard.TargetProperty="X" From="40" To="300" BeginTime="0:0:2" Duration="0:0:0.9" />
                                            <DoubleAnimation Storyboard.TargetName="MeteorMove" Storyboard.TargetProperty="Y" From="30" To="168" BeginTime="0:0:2" Duration="0:0:0.9" />
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:2">
                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="0.95" />
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                        <!-- Hành tinh có vành, trôi lên xuống chậm -->
                        <Canvas Canvas.Left="300" Canvas.Top="96">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="PlanetFloat" />
                            </Canvas.RenderTransform>
                            <Canvas.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PlanetFloat" Storyboard.TargetProperty="Y" From="-5" To="5" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Canvas.Triggers>
                            <Ellipse Width="46" Height="46">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.32,0.28" Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#B9C7FF" Offset="0" />
                                        <GradientStop Color="#5B7CFF" Offset="0.35" />
                                        <GradientStop Color="#4B2FD0" Offset="0.7" />
                                        <GradientStop Color="#1B0F5A" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Canvas.Left="-12" Canvas.Top="17" Width="70" Height="12" Stroke="#99B4C8FF" StrokeThickness="1.4">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-18" CenterX="35" CenterY="6" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                    </Canvas>
                </Viewbox>
            <DockPanel Margin="36,34,36,26">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="42" Height="42" Style="{StaticResource IconImage}" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Làm 1 Chạm" FontSize="19" FontWeight="ExtraBold" Foreground="White" />
                        <TextBlock Text="Một chạm – Sẵn sàng sử dụng" FontSize="11" Foreground="#ADC8EF" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding AppVersion}" FontSize="11" Foreground="{StaticResource NavLabelBrush}" />

                <!-- Giới thiệu ngắn + hình minh họa laptop đang chạy mã thiết lập (vẽ vector, không dùng ảnh ngoài) -->
                <StackPanel VerticalAlignment="Center">
                    <Viewbox MaxWidth="300" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,24"
                             AutomationProperties.Name="Minh họa: laptop đang chạy mã thiết lập máy">
                        <Canvas Width="300" Height="184">
                            <!-- Quầng sáng dưới máy -->
                            <Ellipse Canvas.Left="30" Canvas.Top="166" Width="240" Height="16">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#663B82F6" Offset="0" />
                                        <GradientStop Color="#003B82F6" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Viền màn hình -->
                            <Border Canvas.Left="30" Canvas.Top="0" Width="240" Height="152" CornerRadius="10"
                                    Background="#0A1630" BorderBrush="#3D5F92" BorderThickness="1.5" />
                            <!-- Màn hình -->
                            <Border Canvas.Left="39" Canvas.Top="9" Width="222" Height="134" CornerRadius="5" Background="#0F2242" />
                            <!-- Thanh tiêu đề cửa sổ soạn mã -->
                            <Ellipse Canvas.Left="47" Canvas.Top="16" Width="6" Height="6" Fill="#FF6B6B" />
                            <Ellipse Canvas.Left="57" Canvas.Top="16" Width="6" Height="6" Fill="#FFC24B" />
                            <Ellipse Canvas.Left="67" Canvas.Top="16" Width="6" Height="6" Fill="#3DDC97" />
                            <TextBlock Canvas.Left="80" Canvas.Top="14" Text="ThietLapMay.cs" FontFamily="{StaticResource MonoFont}" FontSize="7.5" Foreground="#6F8DB8" />
                            <Rectangle Canvas.Left="39" Canvas.Top="27" Width="222" Height="1" Fill="#1E365C" />
                            <!-- Số dòng -->
                            <TextBlock Canvas.Left="45" Canvas.Top="33" FontFamily="{StaticResource MonoFont}" FontSize="8.5" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                       Foreground="#46638F" TextAlignment="Right" Width="9" Text="1&#x0a;2&#x0a;3&#x0a;4&#x0a;5&#x0a;6&#x0a;7" />
                            <!-- Mã (tô màu như trình soạn mã) -->
                            <TextBlock Canvas.Left="60" Canvas.Top="33" FontFamily="{StaticResource MonoFont}" FontSize="8.5" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                       Foreground="#D4E2F7">
                                <Run Foreground="#6A9955" Text="// Làm 1 Chạm: một chạm là xong" /><LineBreak />
                                <Run Foreground="#569CD6" Text="var" /><Run Text=" may = " /><Run Foreground="#569CD6" Text="await" /><Run Text=" " /><Run Foreground="#4EC9B0" Text="Quet" /><Run Text="." /><Run Foreground="#DCDCAA" Text="MayMoi" /><Run Text="();" /><LineBreak />
                                <Run Foreground="#C586C0" Text="foreach" /><Run Text=" (" /><Run Foreground="#569CD6" Text="var" /><Run Text=" app " /><Run Foreground="#C586C0" Text="in" /><Run Text=" " /><Run Foreground="#9CDCFE" Text="GoiThietYeu" /><Run Text=")" /><LineBreak />
                                <Run Text="    " /><Run Foreground="#569CD6" Text="await" /><Run Text=" " /><Run Foreground="#4EC9B0" Text="WinGet" /><Run Text="." /><Run Foreground="#DCDCAA" Text="Cai" /><Run Text="(app);" /><LineBreak />
                                <Run Foreground="#4EC9B0" Text="ToiUu" /><Run Text="." /><Run Foreground="#DCDCAA" Text="Windows" /><Run Text="();" /><LineBreak />
                                <Run Foreground="#4EC9B0" Text="KiemTra" /><Run Text="." /><Run Foreground="#DCDCAA" Text="PhanCung" /><Run Text="();" /><LineBreak />
                                <Run Foreground="#4EC9B0" Text="BaoCao" /><Run Text="." /><Run Foreground="#DCDCAA" Text="Xuat" /><Run Text="(); " /><Run Foreground="#3DDC97" Text="// ✓ Sẵn sàng" />
                                <!-- Con trỏ nhấp nháy nằm ngay sau chữ cuối, không phụ thuộc độ rộng phông -->
                                <InlineUIContainer BaselineAlignment="TextBottom">
                                    <Rectangle Width="4.5" Height="9" Margin="2,0,0,0" Fill="#7FB3FF">
                                        <Rectangle.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Rectangle.Triggers>
                                    </Rectangle>
                                </InlineUIContainer>
                            </TextBlock>
                            <!-- Thân máy và bàn phím -->
                            <Path Fill="#2A4774" Data="M 0,152 L 300,152 L 285,166 Q 282,170 276,170 L 24,170 Q 18,170 15,166 Z" />
                            <Path Fill="#3E64A0" Data="M 0,152 L 300,152 L 298,155 L 2,155 Z" />
                            <Border Canvas.Left="126" Canvas.Top="152" Width="48" Height="5" CornerRadius="0,0,4,4" Background="#1B3358" />
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="Thiết lập laptop mới chỉ với một chạm" FontSize="22" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" LineHeight="29" />
                    <TextBlock Text="Cài phần mềm thiết yếu, tối ưu Windows, kiểm tra phần cứng và xuất báo cáo bàn giao — tự động, xác minh từng bước."
                               FontSize="13" Foreground="#BCD0EE" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20" />
                </StackPanel>
            </DockPanel>
            </Grid>
        </Border>

        <!-- BIỂU MẪU -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Width="380" VerticalAlignment="Center" Margin="0,28">
                <!-- Chọn chế độ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton Style="{StaticResource PillRadio}" GroupName="LoginMode" Content="Đăng nhập"
                                 IsChecked="{Binding IsSignInMode, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                 AutomationProperties.Name="Chế độ đăng nhập" />
                    <RadioButton Style="{StaticResource PillRadio}" GroupName="LoginMode" Content="Đăng ký tài khoản mới"
                                 IsChecked="{Binding IsRegisterMode, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                 AutomationProperties.Name="Chế độ đăng ký" />
                </StackPanel>

                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Margin="0,4,0,18" />

                <!-- Họ tên (chỉ khi đăng ký) -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource Vis}}">
                    <TextBlock Text="Họ và tên" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                    <TextBox x:Name="FullNameBox" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"
                             AutomationProperties.Name="Họ và tên" />
                    <TextBlock Text="Viết có dấu, chỉ gồm chữ cái, ví dụ: Nguyễn Văn An." FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,12" />
                </StackPanel>

                <TextBlock Text="Tên đăng nhập / mã kho" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"
                         AutomationProperties.Name="Tên đăng nhập hoặc mã kho" />
                <TextBlock Text="3–30 ký tự: chữ không dấu, số và . _ -" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,12"
                           Visibility="{Binding IsRegisterMode, Converter={StaticResource Vis}}" />
                <Border Height="12" Visibility="{Binding IsSignInMode, Converter={StaticResource Vis}}" />

                <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" MinHeight="40" MaxLength="64"
                             AutomationProperties.Name="Mật khẩu" />

                <!-- Nhập lại mật khẩu (chỉ khi đăng ký) -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                    <TextBlock Text="Nhập lại mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordConfirmBox" PasswordChanged="OnPasswordConfirmChanged" MinHeight="40" MaxLength="64"
                                 AutomationProperties.Name="Nhập lại mật khẩu" />
                    <TextBlock Text="6–64 ký tự, không có khoảng trắng." FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Thông báo -->
                <Border Background="{StaticResource ErrorTintBrush}" BorderBrush="{StaticResource ErrorLineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                        Visibility="{Binding Problem, Converter={StaticResource NotEmpty}}">
                    <TextBlock Text="{Binding Problem}" FontSize="12" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource WarningTintBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                        Visibility="{Binding Notice, Converter={StaticResource NotEmpty}}">
                    <TextBlock Text="{Binding Notice}" FontSize="12" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource SuccessTintBrush}" BorderBrush="{StaticResource SuccessLineBrush}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                        Visibility="{Binding Success, Converter={StaticResource NotEmpty}}">
                    <TextBlock Text="{Binding Success}" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" />
                </Border>

                <Button Style="{StaticResource HeroButton}" Content="{Binding PrimaryText}" Command="{Binding SubmitCommand}" IsDefault="True"
                        Margin="0,18,0,0" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding PrimaryText}" />

                <TextBlock FontSize="11" Foreground="{StaticResource Text3Brush}" Margin="0,16,0,0" TextWrapping="Wrap">
                    <Run Text="Máy chủ: " /><Run Text="{Binding ServerText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   ·   Mã máy: " /><Run Text="{Binding MachineText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
