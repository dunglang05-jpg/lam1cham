<UserControl x:Class="LamMotCham.App.Views.Pages.HandoverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <UserControl.Resources>
        <!-- Một dòng kiểm tra: icon, tên, bằng chứng, trạng thái, hành động. -->
        <DataTemplate x:Key="CheckRow" DataType="{x:Type vm:TaskRowViewModel}">
            <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="24" Height="24" Style="{StaticResource IconImage}" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource SecondaryDark}" TextWrapping="Wrap" Visibility="{Binding Evidence, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                    <c:StatusChip Grid.Column="2" State="{Binding StateKey}" Text="{Binding StateText}" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource TertiaryButton}" Content="Xem lỗi"
                                Command="{Binding DataContext.ShowErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource OutlinePrimaryButton}" Content="{Binding ManualButtonText}" Command="{Binding ToggleManualCommand}"
                                Visibility="{Binding ShowManualButton, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Kiểm tra bàn giao" Style="{StaticResource H1}" />
                <TextBlock Text="Máy chỉ sẵn sàng bàn giao khi các điều kiện dưới đây đạt. Phần cứng cần kỹ thuật viên thử tay và xác nhận." Style="{StaticResource Body}" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RecheckCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Kiểm tra lại tất cả" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateReportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F9;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Tạo báo cáo bàn giao" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tóm tắt -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <c:StatusChip State="pass" Text="{Binding SummaryPass}" Margin="0,0,8,0" />
            <c:StatusChip State="attention" Text="{Binding SummaryAttention}" Margin="0,0,8,0" />
            <c:StatusChip State="unchecked" Text="{Binding SummaryUnchecked}" />
        </StackPanel>

        <Border Style="{StaticResource CardFlush}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="16,14">
                    <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=clipboard}" Width="26" Height="26" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                    <TextBlock Text="Điều kiện bàn giao" Style="{StaticResource H3}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Conditions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConditionViewModel}">
                            <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource SecondaryDark}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <c:StatusChip Grid.Column="1" State="{Binding StateKey}" Margin="12,0,8,0" />
                                    <Button Grid.Column="2" Style="{StaticResource TertiaryButton}" Content="Xem các mục"
                                            Command="{Binding DataContext.ReviewIssuesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding CanReview, Converter={StaticResource Vis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardFlush}" Margin="0,0,16,0" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="16,14">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=shield}" Width="26" Height="26" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                        <TextBlock Text="Hệ thống" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding SystemChecks}" ItemTemplate="{StaticResource CheckRow}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardFlush}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="16,14">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=chip}" Width="26" Height="26" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                        <TextBlock Text="Phần cứng" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Hardware}" ItemTemplate="{StaticResource CheckRow}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
