<UserControl x:Class="LamMotCham.App.Views.Pages.HandoverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <UserControl.Resources>
        <!-- Một dòng kiểm tra: icon, tên, bằng chứng, trạng thái, hành động. -->
        <DataTemplate x:Key="CheckRow" DataType="{x:Type vm:TaskRowViewModel}">
            <DockPanel MinHeight="32" Background="Transparent" ToolTip="{Binding Evidence}">
                <Image DockPanel.Dock="Left" Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TertiaryButton}" Content="Xem lỗi" FontSize="12" MinHeight="24" Padding="6,0"
                            Command="{Binding DataContext.ShowErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                    <Button Style="{StaticResource OutlinePrimaryButton}" Content="{Binding ManualButtonText}" Command="{Binding ToggleManualCommand}" FontSize="12" MinHeight="26" Padding="10,0" Margin="0,0,6,0"
                            Visibility="{Binding ShowManualButton, Converter={StaticResource Vis}}" />
                    <c:StatusChip State="{Binding StateKey}" Text="{Binding StateText}" Height="22" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13">
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Evidence, Mode=OneWay}" Foreground="{StaticResource Text2Brush}" FontSize="12" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Mô-đun "handover" (QĐ-002) -->
        <c:PageHeader IconKey="clipboard" Heading="Kiểm tra &amp; Bàn giao" ModuleLabel="{Binding Module.Label}"
                      Description="Bấm “Bắt đầu kiểm tra” để kiểm tra Windows, bảo mật, driver, pin và phần cứng. Phần cứng cần thử tay rồi xác nhận.">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CreateReportCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=report}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                        <TextBlock Text="Tạo báo cáo bàn giao" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RecheckCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource WhiteIconChip}" Width="24" Height="24" Margin="0,0,8,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=shield}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="Bắt đầu kiểm tra" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <!-- Tóm tắt -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <c:StatusChip State="pass" Text="{Binding SummaryPass}" Margin="0,0,8,0" />
            <c:StatusChip State="attention" Text="{Binding SummaryAttention}" Margin="0,0,8,0" />
            <c:StatusChip State="unchecked" Text="{Binding SummaryUnchecked}" />
        </StackPanel>

        <!-- Gọn như bản mẫu: mỗi mục một dòng, bằng chứng ngắn bên cạnh (đầy đủ ở tooltip) -->
        <Border Style="{StaticResource Card}" Padding="16,12,16,10" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=clipboard}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                    <TextBlock Text="Điều kiện bàn giao" Style="{StaticResource H3}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Conditions}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:AdaptiveGrid MinItemWidth="400" MaxColumns="2" Gap="28" RowGap="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConditionViewModel}">
                            <DockPanel MinHeight="30" Background="Transparent" ToolTip="{Binding Evidence}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TertiaryButton}" Content="Xem" FontSize="12" MinHeight="24" Padding="6,0"
                                            Command="{Binding DataContext.ReviewIssuesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Visibility="{Binding CanReview, Converter={StaticResource Vis}}" />
                                    <c:StatusChip State="{Binding StateKey}" Height="22" />
                                </StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <c:SplitPanel SideWidth="0" StackBelow="820" Gap="14">
            <Border Style="{StaticResource Card}" Padding="16,12,16,10" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=shield}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                        <TextBlock Text="Hệ thống" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SystemChecks}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12,16,10" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=chip}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                        <TextBlock Text="Phần cứng (thử tay)" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Hardware}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                </StackPanel>
            </Border>
        </c:SplitPanel>
    </StackPanel>
</UserControl>
