<UserControl x:Class="LamMotCham.App.Views.Pages.HandoverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <!-- Mô-đun "handover" (QĐ-002) — bố cục canvas: Danh sách kiểm tra (tiến độ) | Tóm tắt bàn giao (vòng %, điều kiện, báo cáo) -->
    <UserControl.Resources>
        <!-- Một dòng kiểm tra: icon, tên, bằng chứng, trạng thái, nút thử tay -->
        <DataTemplate x:Key="CheckRow" DataType="{x:Type vm:TaskRowViewModel}">
            <Border Style="{StaticResource SettingRow}" Padding="0,9">
                <DockPanel Background="Transparent" ToolTip="{Binding Evidence}">
                    <Border x:Name="Tile" DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,12,0">
                        <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Xem lỗi"
                                Command="{Binding DataContext.ShowErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource OutlinePrimaryButton}" Content="{Binding ManualButtonText}" Command="{Binding ToggleManualCommand}" MinHeight="28" Padding="10,0" Margin="0,0,6,0"
                                Visibility="{Binding ShowManualButton, Converter={StaticResource Vis}}" />
                        <c:StatusChip State="{Binding StateKey}" Text="{Binding StateText}" Height="22" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource RowSub}" Visibility="{Binding Evidence, Converter={StaticResource NotEmpty}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RequiresManual}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileGreenBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#75849A" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <c:PageHeader Eyebrow="QUY TRÌNH NGHIỆM THU" Heading="Kiểm tra &amp; bàn giao" ModuleLabel="{Binding Module.Label}"
                      Description="Bấm “Bắt đầu kiểm tra” để kiểm tra Windows, bảo mật, driver, pin; phần cứng thử tay rồi xác nhận.">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RecheckCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=shield}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,7,0" />
                    <TextBlock Text="Bắt đầu kiểm tra" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </c:PageHeader>

        <c:SplitPanel SideWidth="340" StackBelow="860" Gap="15">
            <!-- Danh sách kiểm tra -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right" Style="{StaticResource TagBlue}">
                            <TextBlock Text="{Binding ChecklistText}" Style="{StaticResource TagBlueText}" />
                        </Border>
                        <TextBlock Text="Danh sách kiểm tra" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Style="{StaticResource MeterBar}" Height="7" Value="{Binding PassPercent, Mode=OneWay}" />

                    <TextBlock Text="HỆ THỐNG" Style="{StaticResource MiniLabel}" />
                    <ItemsControl ItemsSource="{Binding SystemChecks}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                    <TextBlock Text="PHẦN CỨNG — THỬ TAY RỒI XÁC NHẬN" Style="{StaticResource MiniLabel}" />
                    <ItemsControl ItemsSource="{Binding Hardware}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />

                    <Border Style="{StaticResource Note}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource NoteText}" Text="ⓘ  Mục hệ thống do ứng dụng đọc và xác minh. Mục phần cứng cần kỹ thuật viên thử trực tiếp rồi bấm “Đã thử, đạt”." />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Tóm tắt bàn giao -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Tóm tắt bàn giao" FontSize="13" FontWeight="ExtraBold" />
                    <c:RingProgress Value="{Binding PassPercent}" Text="{Binding PassText}" Width="76" Height="76" HorizontalAlignment="Center" Margin="0,16,0,12">
                        <c:RingProgress.RingBrush>
                            <SolidColorBrush Color="#16B982" />
                        </c:RingProgress.RingBrush>
                    </c:RingProgress>
                    <TextBlock Text="{Binding SummaryTitle}" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,8">
                        <c:StatusChip State="pass" Text="{Binding SummaryPass}" Height="22" Margin="0,0,6,4" />
                        <c:StatusChip State="attention" Text="{Binding SummaryAttention}" Height="22" Margin="0,0,6,4" />
                        <c:StatusChip State="unchecked" Text="{Binding SummaryUnchecked}" Height="22" Margin="0,0,0,4" />
                    </WrapPanel>

                    <TextBlock Text="ĐIỀU KIỆN BÀN GIAO" Style="{StaticResource MiniLabel}" />
                    <ItemsControl ItemsSource="{Binding Conditions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConditionViewModel}">
                                <Border Style="{StaticResource SettingRow}" Padding="0,8">
                                    <DockPanel Background="Transparent" ToolTip="{Binding Evidence}">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Style="{StaticResource LinkButton}" Content="Xem"
                                                    Command="{Binding DataContext.ReviewIssuesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Visibility="{Binding CanReview, Converter={StaticResource Vis}}" />
                                            <c:StatusChip State="{Binding StateKey}" Height="22" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="{Binding Evidence}" Style="{StaticResource RowSub}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateReportCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=report}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,7,0" />
                            <TextBlock Text="Tạo báo cáo bàn giao" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </c:SplitPanel>
    </StackPanel>
</UserControl>
