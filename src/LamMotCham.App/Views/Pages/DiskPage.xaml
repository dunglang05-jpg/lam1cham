<UserControl x:Class="LamMotCham.App.Views.Pages.DiskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <!-- Mô-đun "disk" (QĐ-002) — bố cục canvas: Dung lượng ổ đĩa | Tài khoản người dùng; Chia ổ đĩa | Tên máy tính -->
    <StackPanel>
        <c:PageHeader Eyebrow="QUẢN LÝ THIẾT BỊ" Heading="Ổ đĩa &amp; tài khoản" ModuleLabel="{Binding Module.Label}"
                      Description="Tổng hợp thông tin để kiểm tra trước khi bàn giao. Chia ổ có xem trước và xác nhận riêng; không định dạng ổ có sẵn, không xóa tài khoản.">
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="↻  Làm mới thông tin" />
        </c:PageHeader>

        <c:SplitPanel SideWidth="0" StackBelow="820" Gap="15" Margin="0,0,0,15">
            <!-- Dung lượng ổ đĩa -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Dung lượng ổ đĩa" FontSize="13" FontWeight="ExtraBold" Margin="0,0,0,12" />
                    <TextBlock Text="Chưa đọc thông tin ổ đĩa. Bấm “Làm mới thông tin”." Style="{StaticResource Secondary}"
                               Visibility="{Binding HasDrives, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveRow}">
                                <StackPanel Margin="0,0,0,16">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="44" Height="44" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Letter}" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <c:StatusChip State="{Binding HealthKey}" Text="{Binding HealthText}" Height="22" Margin="0,0,6,0" />
                                            <c:StatusChip State="{Binding EncryptionKey}" Text="{Binding EncryptionText}" Height="22" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Type, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource MeterBar}" Height="9" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,10,0,5" />
                                    <TextBlock Text="{Binding Free}" FontSize="11" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Note}">
                        <TextBlock Style="{StaticResource NoteText}" Text="ⓘ  Không định dạng hay xóa phân vùng có sẵn. Chia ổ chỉ thu nhỏ ổ và tạo ổ mới từ phần trống." />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Tài khoản người dùng + mã hóa -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Tài khoản người dùng" FontSize="13" FontWeight="ExtraBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Account}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InfoRow}">
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,12,0">
                                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=user}" Width="19" Height="19" Style="{StaticResource IconImage}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Value}">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource RowSub}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTileCyan}" Width="36" Height="36" Margin="0,0,12,0">
                                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=lock}" Width="19" Height="19" Style="{StaticResource IconImage}" />
                            </Border>
                            <c:StatusChip DockPanel.Dock="Right" State="{Binding EncryptionKey}" Text="{Binding EncryptionText}" Height="22" />
                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding EncryptionDetail}">
                                <TextBlock Text="Mã hóa thiết bị (BitLocker)" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Không đọc, hiển thị hay ghi log khóa khôi phục" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RecoveryHelpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="Hướng dẫn tìm khóa khôi phục ↗" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </c:SplitPanel>

        <c:SplitPanel SideWidth="0" StackBelow="820" Gap="15">
            <!-- Chia ổ đĩa (R3): xem trước, xác nhận riêng -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Disk Management ↗" Command="{Binding OpenDiskManagementCommand}" />
                        <TextBlock Text="Chia ổ đĩa" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ổ cần chia" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SplitSources}" SelectedItem="{Binding SplitSource}" MinHeight="36" AutomationProperties.Name="Ổ cần chia" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Dung lượng mới (GB)" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SplitSizeText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" AutomationProperties.Name="Dung lượng ổ mới tính bằng GB" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Tên ổ mới" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SplitLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" MinHeight="36" AutomationProperties.Name="Tên ổ mới" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding PlanMessage}" FontSize="12" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding PlanRows}" Margin="0,4,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InfoRow}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Text2Brush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding PlanErrors}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding PlanWarnings}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding PreviewSplitCommand}" Content="{Binding PreviewLabel}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SplitCommand}" Content="Chia ổ…" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tên máy tính -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Tên máy tính" FontSize="13" FontWeight="ExtraBold" Margin="0,0,0,12" />
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTilePurple}" Width="36" Height="36" Margin="0,0,12,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=laptop}" Width="19" Height="19" Style="{StaticResource IconImage}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentName}" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Tên hiện tại" Style="{StaticResource RowSub}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Tên mới" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,14,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" CharacterCasing="Upper" MinHeight="36" AutomationProperties.Name="Tên máy mới" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RenameCommand}" Content="Đổi tên…" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding NameHint}" FontSize="11" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding NameInvalid, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding NameHint}" FontSize="11" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding NameInvalid, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
        </c:SplitPanel>
    </StackPanel>
</UserControl>
