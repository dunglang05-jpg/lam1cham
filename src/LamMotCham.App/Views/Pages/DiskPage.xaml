<UserControl x:Class="LamMotCham.App.Views.Pages.DiskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls"
             xmlns:acct="clr-namespace:LamMotCham.Windows.Accounts;assembly=LamMotCham.Windows">
    <!-- Mô-đun "disk" (QĐ-002) — bố cục canvas: Dung lượng ổ đĩa | Tài khoản người dùng; Chia ổ đĩa | Tên máy tính -->
    <StackPanel>
        <c:PageHeader Eyebrow="QUẢN LÝ THIẾT BỊ" Heading="Ổ đĩa &amp; tài khoản" ModuleLabel="{Binding Module.Label}"
                      Description="Tổng hợp thông tin để kiểm tra trước khi bàn giao. Chia ổ có xem trước và xác nhận riêng; không định dạng ổ có sẵn, không xóa tài khoản.">
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="↻  Làm mới thông tin" />
        </c:PageHeader>

        <c:SplitPanel SideWidth="0" StackBelow="820" Gap="14" Margin="0,0,0,14">
            <!-- Dung lượng ổ đĩa -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Style="{StaticResource IconTile}" Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=disk}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="Dung lượng ổ đĩa" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Chưa đọc thông tin ổ đĩa. Bấm “Làm mới thông tin”." Style="{StaticResource Secondary}"
                               Visibility="{Binding HasDrives, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveRow}">
                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="44" Height="44" Margin="0,0,12,0">
                                            <Grid>
                                                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=disk}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding Letter}" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                            </Grid>
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <c:StatusChip State="{Binding HealthKey}" Text="{Binding HealthText}" Height="22" Margin="0,0,6,0" />
                                            <c:StatusChip State="{Binding EncryptionKey}" Text="{Binding EncryptionText}" Height="22" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Type, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource MeterBar}" Height="8" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,8,0,3" />
                                    <TextBlock Text="{Binding Free}" FontSize="11" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Note}">
                        <TextBlock Style="{StaticResource NoteText}" Text="ⓘ  Không định dạng hay xóa phân vùng có sẵn. Chia ổ chỉ thu nhỏ ổ và tạo ổ mới từ phần trống." />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Tài khoản người dùng + mã hóa -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="↻ Đọc lại" Command="{Binding ReloadUsersCommand}" />
                        <Border Style="{StaticResource IconTilePurple}" Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=user}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="Tài khoản người dùng" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding UsersMessage}" Style="{StaticResource Secondary}" Margin="0,6,0,0"
                               Visibility="{Binding UsersMessage, Converter={StaticResource NotEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Users}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type acct:LocalAccount}">
                                <Border Style="{StaticResource SettingRow}" Padding="0,8">
                                    <DockPanel>
                                        <Border x:Name="Tile" DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="36" Height="36" Margin="0,0,12,0">
                                            <Image x:Name="Ic" Source="{Binding Converter={StaticResource Icon}, ConverterParameter=user}" Width="19" Height="19" Style="{StaticResource IconImage}" />
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Border Style="{StaticResource TagGreen}" Margin="0,0,8,0" Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}">
                                                <TextBlock Text="Đang dùng" Style="{StaticResource TagGreenText}" />
                                            </Border>
                                            <Button Style="{StaticResource SecondaryButton}" MinHeight="30" FontSize="12" Padding="12,0" Content="✎  Sửa"
                                                    Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsLocal, Converter={StaticResource Vis}}" AutomationProperties.Name="Sửa tài khoản" />
                                            <Border Style="{StaticResource Tag}" Visibility="{Binding IsLocal, Converter={StaticResource Vis}, ConverterParameter=invert}"
                                                    ToolTip="Tài khoản Microsoft: đổi tên và mật khẩu tại account.microsoft.com">
                                                <TextBlock Text="Microsoft" Style="{StaticResource TagText}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitle}">
                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding FullName, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource Text2Brush}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource RowSub}">
                                                <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SourceText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileAmberBrush}" />
                                        <Setter TargetName="Ic" Property="Source" Value="{Binding Converter={StaticResource Icon}, ConverterParameter=shield}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTileCyan}" Width="36" Height="36" Margin="0,0,12,0">
                                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=lock}" Width="19" Height="19" Style="{StaticResource IconImage}" />
                            </Border>
                            <c:StatusChip DockPanel.Dock="Right" State="{Binding EncryptionKey}" Text="{Binding EncryptionText}" Height="22" />
                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding EncryptionDetail}">
                                <TextBlock Text="Mã hóa thiết bị (BitLocker)" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Không đọc, hiển thị hay ghi log khóa khôi phục" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding RecoveryHelpCommand}" HorizontalAlignment="Left" Content="Hướng dẫn tìm khóa khôi phục BitLocker ↗" />
                </StackPanel>
            </Border>
        </c:SplitPanel>

        <c:SplitPanel SideWidth="0" StackBelow="820" Gap="14">
            <!-- Chia ổ đĩa (R3): xem trước, xác nhận riêng -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Disk Management ↗" Command="{Binding OpenDiskManagementCommand}" />
                        <Border Style="{StaticResource IconTileAmber}" Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=pie}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="Chia ổ đĩa" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ổ cần chia" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SplitSources}" SelectedItem="{Binding SplitSource}" MinHeight="36" AutomationProperties.Name="Ổ cần chia" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Dung lượng mới (GB)" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SplitSizeText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" AutomationProperties.Name="Dung lượng ổ mới tính bằng GB" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Tên ổ mới" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SplitLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" MinHeight="36" AutomationProperties.Name="Tên ổ mới" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding PlanMessage}" FontSize="12" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding PlanRows}" Margin="0,4,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InfoRow}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Text2Brush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding PlanErrors}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding PlanWarnings}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding PreviewSplitCommand}" Content="{Binding PreviewLabel}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SplitCommand}" Content="Chia ổ…" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tên máy tính -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource IconTileCyan}" Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=laptop}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" FontSize="13">
                            <Run Text="Tên máy tính" FontWeight="ExtraBold" /><Run Text="   " /><Run Text="{Binding CurrentName, Mode=OneWay}" Foreground="{StaticResource Text2Brush}" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="Tên mới" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" CharacterCasing="Upper" MinHeight="36" AutomationProperties.Name="Tên máy mới" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RenameCommand}" Content="Đổi tên…" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding NameHint}" FontSize="11" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding NameInvalid, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding NameHint}" FontSize="11" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding NameInvalid, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
        </c:SplitPanel>
    </StackPanel>
</UserControl>
