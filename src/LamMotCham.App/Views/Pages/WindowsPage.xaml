<UserControl x:Class="LamMotCham.App.Views.Pages.WindowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">

    <StackPanel>
        <!-- Mô-đun "windows" (QĐ-002) -->
        <c:PageHeader IconKey="gear" Heading="Cài đặt &amp; Tối ưu Windows" ModuleLabel="{Binding Module.Label}"
                      Description="Giá trị cũ được lưu để hoàn tác. Không tắt Defender, Tường lửa, Windows Update.">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding UndoCommand}" Content="Hoàn tác thay đổi" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource WhiteIconChip}" Width="24" Height="24" Margin="0,0,8,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=gear}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="{Binding ApplyLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <!-- Gọn như bản mẫu: mỗi nhóm một thẻ (2 cột), mỗi thiết lập một dòng. Mô tả và 6 điểm chi tiết ở tooltip. -->
        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:AdaptiveGrid MinItemWidth="400" MaxColumns="2" Gap="14" RowGap="14" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SettingGroup}">
                    <Border Style="{StaticResource Card}" Padding="16,12,16,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                                        <DockPanel MinHeight="30" Background="Transparent">
                                            <DockPanel.ToolTip>
                                                <StackPanel MaxWidth="420">
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DetailItem}">
                                                                <TextBlock TextWrapping="Wrap" Margin="0,1">
                                                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DockPanel.ToolTip>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" AutomationProperties.Name="{Binding Name}" />
                                            <!-- Chỉ hiện kết quả sau khi chạy -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource TertiaryButton}" Content="Xem lỗi" FontSize="12" MinHeight="24" Padding="6,0"
                                                        Command="{Binding DataContext.ShowErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                                                <c:StatusChip State="{Binding StateKey}" Text="{Binding StateText}" Height="22"
                                                              Visibility="{Binding HasRun, Converter={StaticResource Vis}}" />
                                                <TextBlock Text="chỉ kiểm tra" FontSize="11" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding IsReadOnly, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
