<UserControl x:Class="LamMotCham.App.Views.Pages.WindowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">

    <StackPanel>
        <!-- Mô-đun "windows" (QĐ-002) -->
        <c:PageHeader IconKey="gear" Heading="Cài đặt &amp; Tối ưu Windows" ModuleLabel="{Binding Module.Label}"
                      Description="Giá trị cũ được lưu để hoàn tác. Không tắt Defender, Tường lửa, Windows Update.">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding UndoCommand}" Content="Hoàn tác thay đổi" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource WhiteIconChip}" Width="24" Height="24" Margin="0,0,8,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=gear}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                        </Border>
                        <TextBlock Text="{Binding ApplyLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <!-- Mỗi nhóm một tab ngang -->
        <TabControl Style="{StaticResource PageTabs}" ItemsSource="{Binding Groups}" SelectedIndex="0" AutomationProperties.Name="Nhóm thiết lập">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SettingGroup}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource TabCount}">
                            <TextBlock Text="{Binding Rows.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ChipGrayTextBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:SettingGroup}">
                    <Border Style="{StaticResource CardFlush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="16,10" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                                        <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                                    <Image Grid.Column="1" Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="22" Height="22" Style="{StaticResource IconImage}" HorizontalAlignment="Left" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <c:StatusChip State="{Binding ImpactKey}" Margin="8,0,0,0" Height="20" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryDark}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasRun, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="HIỆN TẠI" Style="{StaticResource ColumnHeader}" />
                                                        <TextBlock Text="{Binding CurrentText}" FontSize="13" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <c:StatusChip Grid.Column="4" State="{Binding StateKey}" Text="{Binding StateText}" Margin="12,0" />
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                        <Button Style="{StaticResource TertiaryButton}" Content="Xem lỗi"
                                                                Command="{Binding DataContext.ShowErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                                                        <Button Style="{StaticResource TertiaryButton}" Content="{Binding IsReadOnly, Converter={StaticResource ReadOnlyVerb}}"
                                                                Command="{Binding DataContext.ApplyOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="6" Style="{StaticResource QuietButton}" Width="32" Command="{Binding ToggleExpandCommand}"
                                                            Visibility="{Binding HasDetails, Converter={StaticResource Vis}}" AutomationProperties.Name="Chi tiết">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding ChevronGlyph}" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                                <Border Background="{StaticResource SubtleBrush}" CornerRadius="8" Padding="14,10" Margin="72,10,36,0"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}">
                                                    <ItemsControl ItemsSource="{Binding Details}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DetailItem}">
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Text2Brush}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </StackPanel>
</UserControl>
