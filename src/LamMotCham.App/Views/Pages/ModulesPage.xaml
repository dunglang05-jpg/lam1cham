<UserControl x:Class="LamMotCham.App.Views.Pages.ModulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modules="clr-namespace:LamMotCham.Presentation.Modules;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <!-- Mô-đun "modules" (QĐ-002) — bố cục canvas: lưới thẻ mô-đun 3 cột + ghi chú -->
    <StackPanel>
        <c:PageHeader Eyebrow="NỀN TẢNG" Heading="Mô-đun &amp; cập nhật" ModuleLabel="{Binding Module.Label}"
                      Description="Mỗi chức năng là một mô-đun riêng, có phiên bản riêng. Mô-đun mới được phát hành cùng một file EXE mới.">
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyInfoCommand}" Content="Sao chép thông tin phiên bản" />
        </c:PageHeader>

        <!-- Trạng thái cập nhật: nói đúng sự thật, chưa có máy chủ thì không báo "có bản mới". -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,15">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTileCyan}" Width="43" Height="43" Margin="0,0,14,0" VerticalAlignment="Top">
                    <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=refresh}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                </Border>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="280">
                    <Border Style="{StaticResource Tag}" HorizontalAlignment="Right">
                        <TextBlock Text="Chưa kết nối" Style="{StaticResource TagText}" />
                    </Border>
                    <TextBlock Text="{Binding Headline}" FontSize="11" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CopiedText}" FontSize="11" Foreground="{StaticResource SuccessTextBrush}" TextAlignment="Right" Margin="0,4,0,0"
                               Visibility="{Binding CopiedText, Converter={StaticResource NotEmpty}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Cập nhật ứng dụng" FontSize="13" FontWeight="ExtraBold" />
                    <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Bản thử nghiệm cập nhật bằng cách tải file EXE mới từ GitHub Actions. Tự kiểm tra cập nhật sẽ có khi máy chủ cập nhật sẵn sàng (giai đoạn 3): kiểm tra SHA-256 và chữ ký, không cập nhật khi đang chạy tác vụ, giữ bản cũ để khôi phục." />
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:AdaptiveGrid MinItemWidth="230" MaxColumns="3" Gap="15" RowGap="15" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type modules:AppModule}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource TagBlue}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource TagBlueText}"><Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                                </Border>
                                <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left">
                                    <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="21" Height="21" Style="{StaticResource IconImage}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="ExtraBold" Margin="0,14,0,4" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" MinHeight="34" />
                            <TextBlock FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,8,0,0">
                                <Run Text="{Binding Id, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text="  ·  " /><Run Text="{Binding KindText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Note}" Margin="0,15,0,0">
            <TextBlock Style="{StaticResource NoteText}"
                       Text="ⓘ  Ứng dụng không tải mã lệnh rời (DLL, script) từ máy chủ. Mô-đun mới đi cùng một bản EXE; danh mục phần mềm có thể cập nhật riêng dưới dạng dữ liệu có chữ ký, chỉ gồm gói đã được duyệt." />
        </Border>
    </StackPanel>
</UserControl>
