<UserControl x:Class="LamMotCham.App.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <!-- Mô-đun "overview" (QĐ-002): thẻ "Một chạm" lớn bên trái, thẻ thiết bị gọn bên phải, Tác vụ nhanh. Mọi số liệu là dữ liệu thật. -->
    <StackPanel>
        <c:PageHeader Eyebrow="BẢNG ĐIỀU KHIỂN" Heading="Xin chào! Sẵn sàng cho laptop mới." ModuleLabel="{Binding Module.Label}"
                      Description="Một chạm để thiết lập đầy đủ, hoặc chọn từng gói bên dưới. Mọi bước được xác minh trước khi báo thành công." />

        <c:SplitPanel SideWidth="340" StackBelow="820" Gap="14">
            <!-- MỘT CHẠM: thẻ chính, nổi bật -->
            <Border CornerRadius="16" Background="{StaticResource ReadinessBrush}" Padding="24,20">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="16" Background="White" Margin="0,0,16,0" VerticalAlignment="Top">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=bolt}" Width="32" Height="32" Style="{StaticResource IconImage}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="MỘT CHẠM" FontSize="11" FontWeight="Bold" Foreground="#CDE0FF" />
                            <TextBlock Text="Thiết lập đầy đủ — sẵn sàng sử dụng." FontSize="23" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="Một lần bấm: cài phần mềm, tối ưu Windows, dọn dẹp và kiểm tra bàn giao — chạy lần lượt, xác minh từng bước."
                                       FontSize="12" Foreground="#DCE9FF" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 4 bước của gói, mỗi bước có icon -->
                    <ItemsControl ItemsSource="{Binding FullSetupLines}" Margin="0,16,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:AdaptiveGrid MinItemWidth="220" MaxColumns="2" Gap="10" RowGap="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SetupLine}">
                                <Border Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="White" Margin="0,0,12,0">
                                            <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="20" Height="20" Style="{StaticResource IconImage}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="18" FontWeight="ExtraBold" Foreground="White" />
                                            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#E3EEFF" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Phần mềm sẽ cài -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Sẽ cài:" FontSize="12" Foreground="#CDE0FF" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ItemsControl ItemsSource="{Binding FullSetupApps}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="White" Margin="0,0,6,0" ToolTip="{Binding Name}">
                                        <Image Width="20" Height="20" Style="{StaticResource IconImage}">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource LogoOrIcon}">
                                                    <Binding Path="LogoKey" />
                                                    <Binding Path="IconKey" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Left" Command="{Binding StartFullCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                                AutomationProperties.Name="Bắt đầu thiết lập đầy đủ">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="White" CornerRadius="10" Padding="18,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=bolt}" Width="20" Height="20" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                                            <TextBlock Text="Bắt đầu thiết lập đầy đủ   →" FontSize="15" FontWeight="Bold" Foreground="#1256BE" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F0F6FF" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="Có hộp xác nhận trước khi chạy. Không tự khởi động lại." FontSize="11" Foreground="#CDE0FF" TextWrapping="Wrap" />
                            <TextBlock Text="Cần đọc thông tin máy trước (Đọc lại ở thẻ bên phải)." FontSize="11" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Visibility="{Binding Machine.Unchecked, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Thiết bị: gọn, mỗi dòng có icon -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding Machine.CheckButtonText}" Command="{Binding Machine.CheckCommand}"
                                VerticalAlignment="Top" />
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="38" Height="38" Margin="0,0,10,0">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=laptop}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Machine.ModelText}" FontSize="14" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Machine.ModelText}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis">
                                <Run Text="Tên máy:" /> <Run Text="{Binding Machine.ComputerName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Machine.Specs}" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SpecRow}">
                                <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,5" ToolTip="{Binding Value}">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="74" FontSize="11" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" Foreground="{StaticResource SuccessTextBrush}" FontWeight="SemiBold" Margin="0,8,0,0"
                               Visibility="{Binding Machine.Checked, Converter={StaticResource Vis}}">
                        <Run Text="✓ Đã kiểm tra lúc" /> <Run Text="{Binding Machine.CheckedAt, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Machine.InventoryStatus}" FontSize="11" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap"
                               Visibility="{Binding Machine.InventoryStatus, Converter={StaticResource NotEmpty}}" />
                </StackPanel>
            </Border>
        </c:SplitPanel>

        <!-- Tác vụ nhanh: các gói còn lại -->
        <DockPanel Margin="0,16,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Xem tất cả mô-đun →" Command="{Binding Main.GoModulesCommand}" />
            <TextBlock Text="Tác vụ nhanh" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding OtherPacks}" Focusable="False" AutomationProperties.Name="Gói thiết lập">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:AdaptiveGrid MinItemWidth="230" MaxColumns="3" Gap="14" RowGap="14" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PackCardViewModel}">
                    <Border Style="{StaticResource Card}" Padding="14,12" ToolTip="{Binding Extra}">
                        <DockPanel>
                            <Border x:Name="Tile" DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding StartCommand}" MinHeight="32" FontSize="12" Padding="12,0"
                                    VerticalAlignment="Center" Margin="10,0,0,0" Content="Bắt đầu →" AutomationProperties.Name="{Binding Title}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Accent}" Value="green">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileGreenBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Accent}" Value="amber">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileAmberBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Accent}" Value="purple">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource TilePurpleBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
