<UserControl x:Class="LamMotCham.App.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="MetricCard" DataType="{x:Type vm:MetricViewModel}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="22" Height="22" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Unit}" FontSize="13" Foreground="{StaticResource Text2Brush}" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource SecondaryDark}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding Percent, Mode=OneWay}" />
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Meta}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tổng quan" Style="{StaticResource H1}" />
                <TextBlock Text="Kiểm tra máy và chuẩn bị các bước trước khi bàn giao." Style="{StaticResource Body}" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenLastReportCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=report}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                        <TextBlock Text="Xem báo cáo gần nhất" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding Machine.CheckCommand}" Margin="0,0,10,0"
                        Visibility="{Binding Machine.Checked, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Machine.CheckButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartPackCommand}"
                        Visibility="{Binding Machine.Checked, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StartLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding Machine.CheckCommand}"
                        Visibility="{Binding Machine.Unchecked, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Machine.CheckButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=laptop}" Width="28" Height="28" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                        <c:StatusChip DockPanel.Dock="Right" State="unchecked" Visibility="{Binding Machine.Unchecked, Converter={StaticResource Vis}}" />
                        <c:StatusChip DockPanel.Dock="Right" State="running" Text="Đang đọc…" Visibility="{Binding Machine.IsChecking, Converter={StaticResource Vis}}" />
                        <TextBlock Text="Tình trạng máy" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Machine.Status}" Visibility="{Binding Machine.Checked, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InfoRow}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Text2Brush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Meta}" Visibility="{Binding Machine.Checked, Converter={StaticResource Vis}}">
                        <Run Text="Kiểm tra lúc" /> <Run Text="{Binding Machine.CheckedAt, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource Text2Brush}"
                               Visibility="{Binding Machine.Unchecked, Converter={StaticResource Vis}}"
                               Text="Chưa đọc thông tin máy. Bấm “Kiểm tra máy” để đọc phiên bản Windows, quyền, mạng và WinGet." />
                </StackPanel>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding Machine.Ram}" ContentTemplate="{StaticResource MetricCard}" Margin="0,0,16,0" Focusable="False" />
            <ContentControl Grid.Column="2" Content="{Binding Machine.SystemDisk}" ContentTemplate="{StaticResource MetricCard}" Margin="0,0,16,0" Focusable="False" />
            <ContentControl Grid.Column="3" Content="{Binding Machine.Cpu}" ContentTemplate="{StaticResource MetricCard}" Focusable="False" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=listcheck}" Width="28" Height="28" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                        <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Gói thao tác nhanh" />
                        <TextBlock DockPanel.Dock="Right" Text="Gói" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Quy trình chuẩn bị" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource LineSoftBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                        <c:StatusChip Grid.Column="2" State="{Binding StateKey}" Text="{Binding StateText}" Margin="12,0" />
                                        <Button Grid.Column="3" Style="{StaticResource TertiaryButton}" Width="36"
                                                Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=clock}" Width="28" Height="28" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                        <TextBlock Text="Tác vụ gần đây" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Chưa có tác vụ nào trong phiên này." Style="{StaticResource Secondary}" Margin="0,8,0,0"
                               Visibility="{Binding Main.Recent.Count, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Main.Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentItem}">
                                <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryDark}" Visibility="{Binding Message, Converter={StaticResource NotEmpty}}" />
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Meta}" />
                                        </StackPanel>
                                        <c:StatusChip Grid.Column="1" State="{Binding StateKey}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
