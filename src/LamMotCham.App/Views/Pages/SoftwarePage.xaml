<UserControl x:Class="LamMotCham.App.Views.Pages.SoftwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Cài phần mềm" Style="{StaticResource H1}" />
                <TextBlock Text="Chọn ứng dụng cần cài. Gói đã có trên máy sẽ được bỏ qua; mỗi gói chỉ báo thành công sau khi xác minh." Style="{StaticResource Body}" Foreground="{StaticResource Text2Brush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshStatusCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Kiểm tra trạng thái cài" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Thiếu WinGet: nêu rõ, cho cách khắc phục, không chạy được hàng đợi. -->
        <Border Background="{StaticResource WarningTintBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16"
                Visibility="{Binding WinGetMissing, Converter={StaticResource Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=alert}" Width="24" Height="24" Style="{StaticResource IconImage}" Margin="0,0,12,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Chưa tìm thấy WinGet (App Installer)" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" />
                    <TextBlock Text="Không thể cài phần mềm khi thiếu WinGet. Hãy cài hoặc cập nhật “App Installer” từ Microsoft Store, sau đó kiểm tra lại." Style="{StaticResource SecondaryDark}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenStoreCommand}" Margin="12,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=store}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                            <TextBlock Text="Mở Microsoft Store" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TertiaryButton}" Command="{Binding RecheckCommand}" Content="Kiểm tra lại" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardFlush}" Margin="0,0,16,0" VerticalAlignment="Top">
                <StackPanel>
                    <!-- Thanh công cụ -->
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,10,0" AutomationProperties.Name="Tìm ứng dụng" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Foreground="{StaticResource Text2Brush}" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock Text="Tìm theo tên hoặc package ID" Style="{StaticResource Secondary}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />
                        </Grid>
                        <ComboBox Grid.Column="1" Width="190" Margin="10,0,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Danh mục" />
                        <CheckBox Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="{Binding RecommendedSelected}" Content="Chọn bộ khuyến nghị" />
                    </Grid>

                    <!-- Tiêu đề cột -->
                    <Border Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Text="ỨNG DỤNG" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="TRẠNG THÁI" Style="{StaticResource ColumnHeader}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Không có ứng dụng nào khớp với bộ lọc." Style="{StaticResource Secondary}" Margin="16,20"
                               Visibility="{Binding NoResults, Converter={StaticResource Vis}}" />

                    <ItemsControl ItemsSource="{Binding Visible}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                                <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Background="{StaticResource SubtleBrush}" HorizontalAlignment="Left">
                                            <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="22" Height="22" Style="{StaticResource IconImage}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border Background="{StaticResource InfoTintBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding NeedsAdmin, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="Toàn máy" FontSize="11" Foreground="{StaticResource InfoTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PackageId}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Text2Brush}"
                                                       Visibility="{Binding DataContext.TechOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryDark}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <c:StatusChip State="{Binding StateKey}" Text="{Binding StateText}" />
                                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource Meta}" Margin="2,3,0,0" Visibility="{Binding MetaText, Converter={StaticResource NotEmpty}}" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Style="{StaticResource TertiaryButton}" Content="Xem lỗi" HorizontalAlignment="Right"
                                                Command="{Binding DataContext.ShowErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="16,12">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}">
                            <Run Text="Đã chọn" /> <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /> <Run Text="ứng dụng" />
                        </TextBlock>
                        <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Command="{Binding ToggleTechCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=terminal}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,6,0" />
                                <TextBlock Text="Hiện/ẩn package ID" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hàng đợi -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=list}" Width="26" Height="26" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                            <TextBlock Text="Hàng đợi cài đặt" Style="{StaticResource H3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding QueueText}" Style="{StaticResource SecondaryDark}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Queue}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="18" Height="18" Style="{StaticResource IconImage}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <c:StatusChip Grid.Column="2" State="{Binding StateKey}" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Divider}" Margin="0,12" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding InstallLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding PlanCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Content="Xem kế hoạch cài" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=info}" Width="22" Height="22" Style="{StaticResource IconImage}" Margin="0,0,10,0" />
                            <TextBlock Text="Cách cài" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource SecondaryDark}" TextWrapping="Wrap"
                                   Text="Cài lần lượt từng gói qua WinGet, chế độ im lặng. Hủy sẽ dừng sau gói đang cài — không ép tắt trình cài đặt. Gói chỉ được báo “Thành công” khi WinGet tìm thấy nó trên máy sau khi cài." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
