<UserControl x:Class="LamMotCham.App.Views.Pages.SoftwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <!-- Mô-đun "software" (QĐ-002) — bố cục canvas: thanh lọc, bảng danh mục, thẻ "Danh sách đã chọn" bên phải -->
    <UserControl.Resources>
        <Style x:Key="Th" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="#75849A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <c:PageHeader Eyebrow="THƯ VIỆN ỨNG DỤNG" Heading="Phần mềm cần thiết" ModuleLabel="{Binding Module.Label}"
                      Description="Danh sách lấy từ Web Admin mỗi lần đăng nhập. Ứng dụng đã có trên máy được bỏ qua; mỗi ứng dụng chỉ báo thành công sau khi xác minh.">
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshStatusCommand}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=refresh}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,7,0" />
                    <TextBlock Text="Kiểm tra trạng thái cài" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </c:PageHeader>

        <!-- QĐ-006: không lấy được danh sách của Web Admin thì nói rõ và dùng danh sách có sẵn. -->
        <Border Background="{StaticResource WarningTintBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,15"
                Visibility="{Binding HasCatalogNotice, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Text="Đang dùng danh sách phần mềm có sẵn" FontWeight="Bold" FontSize="13" Foreground="{StaticResource WarningTextBrush}" />
                <TextBlock Text="{Binding CatalogNotice}" Style="{StaticResource SecondaryDark}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Thiếu WinGet: nêu rõ, cho cách khắc phục; ứng dụng có link tải vẫn cài được. -->
        <Border Background="{StaticResource WarningTintBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,15"
                Visibility="{Binding WinGetMissing, Converter={StaticResource Vis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenStoreCommand}" Content="Mở Microsoft Store" Margin="12,0,8,0" />
                    <Button Style="{StaticResource TertiaryButton}" Command="{Binding RecheckCommand}" Content="Kiểm tra lại" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Chưa tìm thấy WinGet (App Installer)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource WarningTextBrush}" />
                    <TextBlock Text="Ứng dụng chỉ cài được bằng WinGet sẽ chưa cài được; ứng dụng có link tải vẫn cài bình thường. Cài hoặc cập nhật “App Installer” từ Microsoft Store, rồi kiểm tra lại." Style="{StaticResource SecondaryDark}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Thanh lọc (.toolbar) -->
        <DockPanel Margin="0,0,0,15">
            <Grid DockPanel.Dock="Right" Width="220" VerticalAlignment="Center">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Padding="32,0,10,0" FontSize="12" AutomationProperties.Name="Tìm ứng dụng" />
                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=search}" Width="15" Height="15" Style="{StaticResource IconImage}"
                       Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock Text="Tìm ứng dụng" FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource NotEmpty}, ConverterParameter=invert}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding CategoryChips}" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Nhóm ứng dụng">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryChip}">
                        <RadioButton Style="{StaticResource PillRadio}" GroupName="SoftwareCategory" Content="{Binding Label}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2,8,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <c:SplitPanel SideWidth="270" StackBelow="860" Gap="15">
            <!-- Bảng danh mục -->
            <Border Style="{StaticResource CardFlush}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="16,16,16,12">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}">
                            <TextBlock Style="{StaticResource TagText}">
                                <Run Text="{Binding Visible.Count, Mode=OneWay}" /> <Run Text="mục" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Danh mục ứng dụng" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Margin="16,0,16,0" BorderBrush="#EDF1F7" BorderThickness="1" CornerRadius="11">
                        <StackPanel>
                            <!-- Tiêu đề cột -->
                            <Border Background="#F7F9FD" BorderBrush="#E8EEF6" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="11,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CHỌN" Style="{StaticResource Th}" />
                                    <TextBlock Grid.Column="1" Text="PHẦN MỀM" Style="{StaticResource Th}" />
                                    <TextBlock Grid.Column="2" Text="NHÓM" Style="{StaticResource Th}" />
                                    <TextBlock Grid.Column="3" Text="ĐỀ XUẤT" Style="{StaticResource Th}" />
                                    <TextBlock Grid.Column="4" Text="TRẠNG THÁI" Style="{StaticResource Th}" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Không có ứng dụng nào khớp với bộ lọc." Style="{StaticResource Secondary}" Margin="12,16"
                                       Visibility="{Binding NoResults, Converter={StaticResource Vis}}" />

                            <ItemsControl ItemsSource="{Binding Visible}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                                        <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="11,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                                <DockPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <Grid DockPanel.Dock="Left" Width="29" Height="29" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border CornerRadius="9" Background="#F0F5FF" Visibility="{Binding ShowInitial, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                            <Image Width="20" Height="20" Style="{StaticResource IconImage}">
                                                                <Image.Source>
                                                                    <MultiBinding Converter="{StaticResource LogoOrIcon}">
                                                                        <Binding Path="LogoKey" />
                                                                        <Binding Path="IconKey" />
                                                                    </MultiBinding>
                                                                </Image.Source>
                                                            </Image>
                                                        </Border>
                                                        <Border CornerRadius="9" Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" Visibility="{Binding ShowInitial, Converter={StaticResource Vis}}">
                                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding UnavailableReason}" FontSize="11" Foreground="{StaticResource Text2Brush}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Visibility="{Binding UnavailableReason, Converter={StaticResource NotEmpty}}" />
                                                        <ComboBox ItemsSource="{Binding VariantLabels}" SelectedItem="{Binding SelectedVariantLabel, Mode=TwoWay}" FontSize="12" Margin="0,5,0,0" MaxWidth="320" HorizontalAlignment="Left"
                                                                  AutomationProperties.Name="Chọn phiên bản" Visibility="{Binding HasVariants, Converter={StaticResource Vis}}" />
                                                        <TextBlock Text="{Binding PackageId}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Text2Brush}"
                                                                   Visibility="{Binding DataContext.TechOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Vis}}" />
                                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Group}" FontSize="12" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Border Style="{StaticResource TagGreen}" Visibility="{Binding IsRecommended, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="Khuyến nghị" Style="{StaticResource TagGreenText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag}" Visibility="{Binding IsRecommended, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                        <TextBlock Text="Tùy chọn" Style="{StaticResource TagText}" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:StatusChip State="{Binding StateKey}" Text="{Binding StateText}" Height="22" />
                                                        <Button Style="{StaticResource LinkButton}" Content="Xem lỗi" Margin="4,0,0,0"
                                                                Command="{Binding DataContext.ShowErrorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsProblem, Converter={StaticResource Vis}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource Meta}" Margin="2,3,0,0" Visibility="{Binding MetaText, Converter={StaticResource NotEmpty}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="16,10,16,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding ToggleTechCommand}" Content="Hiện/ẩn nguồn cài" />
                        <CheckBox IsChecked="{Binding RecommendedSelected}" Content="Chọn bộ khuyến nghị" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Note}" Margin="12">
                        <TextBlock Style="{StaticResource NoteText}">
                            <Run Text="ⓘ  " /><Run Text="{Binding CatalogSource, Mode=OneWay}" /><Run Text=". Cài qua WinGet (ưu tiên bản tiếng Việt) hoặc link chính thức có chữ ký số của hãng tin cậy; ứng dụng mờ chưa cài tự động được. Hủy giữa chừng sẽ dừng sau ứng dụng đang cài, không ép tắt trình cài đặt." />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Danh sách đã chọn (.sticky-card) -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Danh sách đã chọn" FontSize="13" FontWeight="ExtraBold" />
                    <TextBlock Text="Cài lần lượt, im lặng, xác minh lại sau mỗi gói." FontSize="11" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SelectedCountText}" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource HeadingBrush}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding SkipNote}" FontSize="11" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,2,0,8" />

                    <ItemsControl ItemsSource="{Binding SelectedRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
                                <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Width="29" Height="29" Margin="0,0,9,0">
                                            <Border CornerRadius="9" Background="#F0F5FF" Visibility="{Binding ShowInitial, Converter={StaticResource Vis}, ConverterParameter=invert}">
                                                <Image Width="20" Height="20" Style="{StaticResource IconImage}">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource LogoOrIcon}">
                                                            <Binding Path="LogoKey" />
                                                            <Binding Path="IconKey" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Border>
                                            <Border CornerRadius="9" Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" Visibility="{Binding ShowInitial, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{StaticResource Text2Brush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=download}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding InstallLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding PlanCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"
                            Content="Xem kế hoạch cài" />
                    <TextBlock Text="{Binding QueueText}" Style="{StaticResource Meta}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Visibility="{Binding QueueEmpty, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                </StackPanel>
            </Border>
        </c:SplitPanel>
    </StackPanel>
</UserControl>
