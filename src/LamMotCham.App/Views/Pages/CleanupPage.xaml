<UserControl x:Class="LamMotCham.App.Views.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LamMotCham.Presentation.ViewModels;assembly=LamMotCham.Presentation"
             xmlns:c="clr-namespace:LamMotCham.App.Controls">
    <!-- Mô-đun "cleanup" (QĐ-002): một thẻ gọn — tổng quan quét + nút, nhóm file 2 cột, dải nguyên tắc an toàn -->
    <UserControl.Resources>
        <Style x:Key="RuleTag" TargetType="Border" BasedOn="{StaticResource TagGreen}">
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <c:PageHeader Eyebrow="BẢO TRÌ THIẾT BỊ" Heading="Dọn dẹp &amp; hiệu năng" ModuleLabel="{Binding Module.Label}"
                      Description="Quét để xem dung lượng từng nhóm trước khi dọn. Chỉ xóa trong các thư mục tạm đã liệt kê." />

        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <!-- Tổng quan quét -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=search}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding ScanLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Converter={StaticResource Icon}, ConverterParameter=broom}" Width="16" Height="16" Style="{StaticResource IconImage}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding CleanLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <c:RingProgress DockPanel.Dock="Left" Value="{Binding SelectedPercent}" Text="{Binding SelectedShort}" Width="64" Height="64" Margin="0,0,14,0">
                        <c:RingProgress.RingBrush>
                            <SolidColorBrush Color="#438AFA" />
                        </c:RingProgress.RingBrush>
                    </c:RingProgress>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center">
                                <Run Text="Có thể giải phóng" /> <Run Text="{Binding TotalText, Mode=OneWay}" />
                            </TextBlock>
                            <Border Style="{StaticResource TagGreen}" Margin="10,0,0,0" Visibility="{Binding Scanned, Converter={StaticResource Vis}}">
                                <TextBlock Text="Đã quét" Style="{StaticResource TagGreenText}" />
                            </Border>
                            <Border Style="{StaticResource Tag}" Margin="10,0,0,0" Visibility="{Binding NotScanned, Converter={StaticResource Vis}}">
                                <TextBlock Text="Chưa quét" Style="{StaticResource TagText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ScannedAt}" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,3,0,0"
                                   Visibility="{Binding Scanned, Converter={StaticResource Vis}}" />
                        <TextBlock Text="Bấm “Quét và xem trước” để biết dung lượng từng nhóm. Chưa xóa gì cho đến khi xác nhận." FontSize="11"
                                   Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding NotScanned, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>

                <!-- Nhóm file: 2 cột -->
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:AdaptiveGrid MinItemWidth="380" MaxColumns="2" Gap="28" RowGap="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CleanupItemViewModel}">
                            <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Row.IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"
                                              AutomationProperties.Name="{Binding Name}" />
                                    <Border x:Name="Tile" DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="34" Height="34" Margin="0,0,10,0">
                                        <Image Source="{Binding IconKey, Converter={StaticResource Icon}}" Width="18" Height="18" Style="{StaticResource IconImage}" />
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <c:StatusChip State="{Binding Row.StateKey}" Text="{Binding Row.StateText}" Height="22" Margin="0,0,8,0"
                                                      Visibility="{Binding Row.HasRun, Converter={StaticResource Vis}}" />
                                        <TextBlock Text="{Binding Size}" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding Scope}">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowSub}">
                                            <Run Text="{Binding Files, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Scope, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Note, Converter={StaticResource NotEmpty}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SafetyKey}" Value="review">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileAmberBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nguyên tắc an toàn: luôn áp dụng -->
                <WrapPanel Margin="0,12,0,0">
                    <Border Style="{StaticResource RuleTag}"><TextBlock Text="✓ Không đụng tài liệu, ảnh, Desktop, Downloads" Style="{StaticResource TagGreenText}" /></Border>
                    <Border Style="{StaticResource RuleTag}"><TextBlock Text="✓ Không xóa mật khẩu, cookie, dữ liệu đăng nhập" Style="{StaticResource TagGreenText}" /></Border>
                    <Border Style="{StaticResource RuleTag}"><TextBlock Text="✓ File đang dùng được bỏ qua" Style="{StaticResource TagGreenText}" /></Border>
                    <Border Style="{StaticResource RuleTag}" Background="{StaticResource WarningTintBrush}">
                        <TextBlock Text="! Thùng rác không chọn sẵn — hỏi khách trước" Style="{StaticResource TagAmberText}" />
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
