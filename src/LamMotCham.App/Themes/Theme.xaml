<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:LamMotCham.App.Controls"
                    xmlns:conv="clr-namespace:LamMotCham.App.Converters">

    <!-- Màu theo thiết kế canvas "Làm 1 Chạm — UI Canvas" (lam1cham_canvas.html) -->
    <Color x:Key="PrimaryColor">#1764E8</Color>
    <Color x:Key="PrimaryHoverColor">#135DE0</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1764E8" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#135DE0" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#2369D8" />
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#F3F7FF" />
    <SolidColorBrush x:Key="HeadingBrush" Color="#14294A" />
    <SolidColorBrush x:Key="TextBrush" Color="#172944" />
    <SolidColorBrush x:Key="Text2Brush" Color="#78879D" />
    <SolidColorBrush x:Key="Text3Brush" Color="#526B8D" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F7FC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#F8FAFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#E4EAF4" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="ControlLineBrush" Color="#DBE4F2" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#DBE4F2" />
    <SolidColorBrush x:Key="ChipGrayBrush" Color="#F0F3F8" />
    <SolidColorBrush x:Key="ChipGrayTextBrush" Color="#67768B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#12A879" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#0B9466" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#E5F8F0" />
    <SolidColorBrush x:Key="SuccessLineBrush" Color="#BFE9D8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A623" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#A66A07" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="#FFF3DD" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D84A65" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B4233F" />
    <SolidColorBrush x:Key="ErrorTintBrush" Color="#FFF5F7" />
    <SolidColorBrush x:Key="ErrorLineBrush" Color="#F6C7D0" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1764E8" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#526B8D" />
    <SolidColorBrush x:Key="InfoTintBrush" Color="#F0F6FF" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#E4E9F1" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#6610213F" />

    <!-- Thanh bên màu navy -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#103665" Offset="0" />
        <GradientStop Color="#071F47" Offset="0.85" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavActiveBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#267CF4" Offset="0" />
        <GradientStop Color="#1C65DF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavTextBrush" Color="#BDD0ED" />
    <SolidColorBrush x:Key="NavLabelBrush" Color="#7898C1" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1AFFFFFF" />
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C7CFA" Offset="0" />
        <GradientStop Color="#135DE0" Offset="1" />
    </LinearGradientBrush>
    <!-- Nút thực thi trên nền xanh (thẻ Một chạm): xanh lá nổi bật -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FC48A" Offset="0" />
        <GradientStop Color="#0E9466" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0C8A5E" />
    <LinearGradientBrush x:Key="ReadinessBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#144C9D" Offset="0" />
        <GradientStop Color="#1E73EB" Offset="1" />
    </LinearGradientBrush>

    <!-- Nền ô icon theo màu (ic.blue, ic.green, ...) -->
    <SolidColorBrush x:Key="TileBlueBrush" Color="#E7F0FF" />
    <SolidColorBrush x:Key="TileGreenBrush" Color="#DEF8ED" />
    <SolidColorBrush x:Key="TileAmberBrush" Color="#FFF1D8" />
    <SolidColorBrush x:Key="TilePurpleBrush" Color="#EEE7FF" />
    <SolidColorBrush x:Key="TileCyanBrush" Color="#DEF7FA" />
    <SolidColorBrush x:Key="TileRoseBrush" Color="#FFE9ED" />

    <FontFamily x:Key="UiFont">Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <conv:IconConverter x:Key="ThemeIcon" />

    <!--
        QUAN TRỌNG: trong file này, một tài nguyên chỉ được dùng {StaticResource} tới tài nguyên khai báo PHÍA TRÊN nó
        (kể cả bên trong ControlTemplate). Dùng trước khai báo sẽ lỗi "StaticResourceHolder threw an exception" khi chạy.
        Test ThemeResourceOrderTests kiểm tra quy tắc này.
    -->
    <Style x:Key="IconImage" TargetType="Image">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource LineSoftBrush}" />
    </Style>

    <!-- Chữ: không dưới 11 px cho thông tin cần đọc -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <!-- Nhãn nhỏ viết hoa màu xanh phía trên tiêu đề (eyebrow) -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>
    <!-- Tiêu đề khu vực (Tác vụ nhanh, Tình trạng tổng thể) -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SecondaryDark" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>
    <Style x:Key="Meta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlyphFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Vòng focus rõ ràng (UI/UX Handoff mục 6, 17) -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style x:Key="CardFlush" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Ô vuông nền xanh nhạt chứa icon -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="39" />
        <Setter Property="Height" Value="39" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource TileBlueBrush}" />
    </Style>
    <Style x:Key="IconTileGreen" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{StaticResource TileGreenBrush}" />
    </Style>
    <Style x:Key="IconTileAmber" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{StaticResource TileAmberBrush}" />
    </Style>
    <Style x:Key="IconTilePurple" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{StaticResource TilePurpleBrush}" />
    </Style>
    <Style x:Key="IconTileCyan" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{StaticResource TileCyanBrush}" />
    </Style>
    <Style x:Key="IconTileRose" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{StaticResource TileRoseBrush}" />
    </Style>

    <!-- Ghi chú nền xanh nhạt (.note) -->
    <Style x:Key="Note" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InfoTintBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="13,10" />
    </Style>
    <Style x:Key="NoteText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Dòng thiết lập (.setting-row): icon, chữ, điều khiển; đường kẻ dưới -->
    <Style x:Key="SettingRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,9" />
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RowSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Ô trắng nhỏ chứa icon trên nút xanh -->
    <Style x:Key="WhiteIconChip" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- Nhãn xám nhỏ (nhóm, mô-đun) -->
    <Style x:Key="GrayTag" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChipGrayBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GrayTagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ChipGrayTextBrush}" />
    </Style>

    <!-- Nút -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Nút chính lớn (Bắt đầu, Cài đặt, Áp dụng) -->
    <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Nút phụ: nền xanh nhạt, chữ xanh (không dùng nền trắng để dễ nhận ra là nút bấm) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="#EAF2FF" />
        <Setter Property="BorderBrush" Value="#CFE0FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#1C60D4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DCEAFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutlinePrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="TertiaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource TertiaryButton}">
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F1F4F9" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Mục điều hướng trên thanh bên navy: đang chọn = nền xanh gradient, chữ trắng đậm -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavActiveBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút phụ trên thanh bên (Mở log, Mở báo cáo) -->
    <Style x:Key="SideButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thẻ chọn gói (Tổng quan) -->
    <Style x:Key="PackCard" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="118" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="#E0E7F3" BorderThickness="1.5" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Top" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút lọc dạng viên thuốc (nhóm ứng dụng) -->
    <Style x:Key="PillRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#63748B" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="#E1E8F3" BorderThickness="1" CornerRadius="8" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EAF2FF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#CFE0FF" />
                            <Setter Property="Foreground" Value="#1C60D4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiêu đề trang (.page-heading): nhãn nhỏ, tiêu đề lớn + nhãn mô-đun, mô tả; nút ở bên phải -->
    <Style TargetType="c:PageHeader">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:PageHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{TemplateBinding Eyebrow}" Style="{StaticResource Eyebrow}" Margin="0,0,0,3" />
                            <WrapPanel>
                                <TextBlock Text="{TemplateBinding Heading}" Style="{StaticResource H1}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border Style="{StaticResource GrayTag}">
                                    <TextBlock Text="{TemplateBinding ModuleLabel}" Style="{StaticResource GrayTagText}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{TemplateBinding Description}" FontSize="12" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Top" Margin="16,4,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox 18px, có vòng focus -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="#98A2B3" Background="White" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Path x:Name="Mark" Data="M3.5,9 L7,12.5 L14.5,5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Margin="-0.5,-0.5,0,0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ControlLineBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Background" Value="#E8EEF8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="MeterBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Background" Value="#E8EEF8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Maximum" Value="100" />
    </Style>

    <Style x:Key="GreenMeter" TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
        <Setter Property="Height" Value="5" />
        <Setter Property="Foreground" Value="#2E9E5B" />
    </Style>

    <!-- Công tắc (.switch): bật = xanh lá -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#DBE2EC">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.18" Color="#102244" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#20B47F" />
                            <Setter TargetName="Thumb" Property="Margin" Value="19,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nhãn nhỏ (.tag) -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource ChipGrayBrush}" />
    </Style>
    <Style x:Key="TagGreen" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
    </Style>
    <Style x:Key="TagBlue" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{StaticResource PrimaryTintBrush}" />
    </Style>
    <Style x:Key="TagAmber" TargetType="Border" BasedOn="{StaticResource Tag}">
        <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
    </Style>
    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource ChipGrayTextBrush}" />
    </Style>
    <Style x:Key="TagGreenText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
    </Style>
    <Style x:Key="TagBlueText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="TagAmberText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
    </Style>

    <!-- Liên kết nhỏ (Xem tất cả mô-đun →) -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource TertiaryButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
    </Style>

</ResourceDictionary>
