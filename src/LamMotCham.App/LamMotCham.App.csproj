<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LamMotCham</AssemblyName>
    <RootNamespace>LamMotCham.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyTitle>Làm 1 Chạm</AssemblyTitle>
    <Description>Thiết lập laptop mới — một chạm, sẵn sàng sử dụng.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\png\*.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LamMotCham.Core\LamMotCham.Core.csproj" />
    <ProjectReference Include="..\LamMotCham.Windows\LamMotCham.Windows.csproj" />
    <ProjectReference Include="..\LamMotCham.Presentation\LamMotCham.Presentation.csproj" />
  </ItemGroup>
</Project>
