<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LamMotCham</AssemblyName>
    <RootNamespace>LamMotCham.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyTitle>Làm 1 Chạm</AssemblyTitle>
    <Description>Thiết lập laptop mới — một chạm, sẵn sàng sử dụng.</Description>
  </PropertyGroup>

  <!--
    Mô-đun "account": địa chỉ và khóa truy cập máy chủ đăng nhập (api.php) nạp lúc build, không nằm trong mã nguồn.
    CI lấy khóa từ secret LMC_API_KEY (biến môi trường cùng tên); build cục bộ: đặt biến LMC_API_KEY hoặc -p:LmcApiKey=...
    Không có khóa thì ứng dụng vẫn build được nhưng màn hình đăng nhập báo chưa cấu hình máy chủ.
  -->
  <PropertyGroup>
    <LmcApiKey Condition="'$(LmcApiKey)' == ''">$(LMC_API_KEY)</LmcApiKey>
    <LmcAccountEndpoint Condition="'$(LmcAccountEndpoint)' == ''">https://dunglam.top/api.php</LmcAccountEndpoint>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LmcApiKey" Value="$(LmcApiKey)" />
    <AssemblyMetadata Include="LmcAccountEndpoint" Value="$(LmcAccountEndpoint)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\png\*.png" />
    <Resource Include="Assets\Logos\*.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LamMotCham.Core\LamMotCham.Core.csproj" />
    <ProjectReference Include="..\LamMotCham.Windows\LamMotCham.Windows.csproj" />
    <ProjectReference Include="..\LamMotCham.Presentation\LamMotCham.Presentation.csproj" />
  </ItemGroup>
</Project>
