<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>vi-VN</NeutralLanguage>
    <Company>Làm 1 Chạm</Company>
    <Product>Làm 1 Chạm</Product>
    <Version>0.14.0</Version>
    <InformationalVersion>0.14.0-thu-nghiem</InformationalVersion>
    <!-- Khóa phiên bản gói khi restore (tài liệu 06: pin dependency). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- RestoreLockedMode bật lại khi packages.lock.json (gồm cả RID win-x64) đã được commit. -->
    <RestoreLockedMode Condition="'$(LmcLockedRestore)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
