<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Công cụ kiểm tra danh sách ứng dụng của Web Admin trên máy CI (QĐ-006): tải từng link, kiểm tra chữ ký số và hãng tin cậy,
    đối chiếu nhà phát hành WinGet, cài thử vài ứng dụng. Không nằm trong LamMotCham.sln và không đóng gói vào EXE.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LamMotCham.AppCheck</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows10.0.19041</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LamMotCham.Windows\LamMotCham.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="apps-admin.json" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
